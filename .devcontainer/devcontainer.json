{
	"image": "mcr.microsoft.com/devcontainers/universal:6",
	"features": {
		"ghcr.io/devcontainers/features/rust:1": {
			"version": "latest",
			"profile": "complete",
			"targets": "aarch64-unknown-linux-gnu"
		},
		"ghcr.io/guiyomh/features/just:0": {
			"version": "latest"
		}
	},
	"containerEnv": {
		// Avoid retaining incremental compiler caches, which can consume substantial disk space.
		"CARGO_INCREMENTAL": "0",
		// Omit test-profile debug information to keep test build artifacts smaller.
		"CARGO_PROFILE_TEST_DEBUG": "0",
		// Keep the large Cargo build tree off persistent workspace storage when /tmp is separate.
		"CARGO_TARGET_DIR": "/tmp/biome-target"
	},
	"hostRequirements": {
		"storage": "48gb"
	}
}
