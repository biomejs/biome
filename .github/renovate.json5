{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Gibraltar",
  "schedule": [
    "before 9am on monday"
  ],
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "rangeStrategy": "bump",
  "lockFileMaintenance": {
    "enabled": false
  },
  "assignees": [
    "@biomejs/maintainers",
    "@biomejs/core-contributors"
  ],
  "packageRules": [
    {
      "minimumReleaseAge": "3 days",
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "!rust"
      ]
    },
    {
      // Must be at least `registry.global-min-publish-age` in .cargo/config.toml,
      // otherwise Cargo refuses to resolve the version Renovate proposes.
      // Covers every Cargo.toml, including the root `[workspace.dependencies]`.
      "minimumReleaseAge": "3 days",
      "matchDatasources": [
        "crate"
      ]
    },
    {
      "minimumReleaseAge": "3 days",
      "groupName": "Rust crates",
      "matchManagers": [
        "cargo"
      ],
      "matchFileNames": [
        "Cargo.toml",
        "crates/**",
        "xtask/**"
      ],
      "ignoreDeps": [
        "syn",
        "quote",
        "tower",
        "hashbrown",
        "grit-pattern-matcher",
        "grit-util",
        "getrandom",
        "rand",
        // Needs to be updated manually. `js-sys` is released in lockstep with
        // `wasm-bindgen` and requires an exact `wasm-bindgen` version.
        "wasm-bindgen-cli",
        "wasm-bindgen",
        "js-sys"
      ]
    },
    {
      "minimumReleaseAge": "3 days",
      "groupName": "@biomejs packages",
      "matchFileNames": [
        "packages/**"
      ],
      "matchManagers": [
        "npm"
      ]
    },
    {
      // Needs to be updated manually, together with the generated Tailwind preset
      "matchFileNames": [
        "packages/tailwindcss-config-analyzer/**"
      ],
      "matchDepNames": [
        "tailwindcss"
      ],
      "enabled": false
    },
    {
      "minimumReleaseAge": "3 days",
      "matchDepNames": [
        "rust"
      ]
    },
    {
      "minimumReleaseAge": "3 days",
      "matchDepTypes": [
        "engines"
      ],
      "matchDepNames": [
        "!pnpm"
      ],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)rust-toolchain\\.toml?$/"
      ],
      "matchStrings": [
        "channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\""
      ],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags"
    }
  ]
}
