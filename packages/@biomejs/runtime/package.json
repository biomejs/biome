{
  "name": "@biomejs/runtime",
  "version": "2.6.4",
  "description": "JavaScript APIs for Biome JS plugins",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test:types": "pnpm run build && tsc --project tsconfig.json",
    "test": "pnpm run build && node --import ./tests/setup.ts --test \"tests/**/*.test.ts\""
  },
  "files": [
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "lib",
    "src"
  ],
  "type": "module",
  "exports": {
    "./plugin": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    },
    "./plugin/testing": {
      "types": "./lib/plugin/testing/rule-tester.d.ts",
      "default": "./lib/plugin/testing/rule-tester.js"
    }
  },
  "license": "MIT OR Apache-2.0",
  "homepage": "https://biomejs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biomejs/biome.git",
    "directory": "packages/@biomejs/runtime"
  },
  "author": "Biome Developers and Contributors",
  "bugs": "https://github.com/biomejs/biome/issues",
  "dependencies": {
    "@biomejs/backend-jsonrpc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@biomejs/biome": "*"
  },
  "publishConfig": {
    "provenance": true
  }
}
