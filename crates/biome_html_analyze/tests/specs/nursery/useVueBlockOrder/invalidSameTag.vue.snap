invalidSameTag.vue:3:1 lint/nursery/useVueBlockOrder  FIXABLE  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i The <script> block should be above the <style> block.
  
    1 │ <!-- should generate diagnostics -->
    2 │ <style></style>
  > 3 │ <script></script>
      │ ^^^^^^^^^^^^^^^^^
    4 │ <template></template>
    5 │ <script setup></script>
  
  i This <style> block should come after it.
  
    1 │ <!-- should generate diagnostics -->
  > 2 │ <style></style>
      │ ^^^^^^^^^^^^^^^
    3 │ <script></script>
    4 │ <template></template>
  
  i Putting the blocks of every component in the same order makes components easier to read.
  
  i This project puts top-level blocks in this order: <script> and <template> in any order, then <style>.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  
  i Unsafe fix: Move the <script> block above the <style> block.
  
    1 1 │   <!-- should generate diagnostics -->
    2   │ - <style></style>
    3   │ - <script></script>
      2 │ + <script></script>
      3 │ + <style></style>
