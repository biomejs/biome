invalid.vue:3:14 lint/nursery/useVueSlotNameCasing ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i The slot name foo-bar isn't in camelCase.
  
    1 │ <!-- should generate diagnostics -->
    2 │ <template>
  > 3 │   <slot name="foo-bar" />
      │              ^^^^^^^^^
    4 │   <slot name="foo_bar" />
    5 │   <slot name="foo:bar" />
  
  i Vue doesn't convert slot names between casings, so components that fill this slot must use the exact same name. Using one casing for every slot name keeps them consistent.
  
  i Rename the slot so that it is in camelCase, and update the components that fill it.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

