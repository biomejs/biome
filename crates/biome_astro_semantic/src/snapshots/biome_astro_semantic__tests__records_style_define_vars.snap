---
<style define:vars={{ foreground, accent: "blue", "\x66oo": 1, 1e2: "a", 0x64: "b", [0x64n]: "c", 0x100000000000000000000000000000000: "large", [-1]: "negative", [-1n]: "negativeBigint" }}>
