## Command

```shell
biome lint card.tsx
```

## `biome.json`

```json
{
  "linter": {
    "rules": { "correctness": "error" },
    "domains": { "solid": "none" }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "correctness": { "noUnusedVariables": "off" }
        }
      }
    }
  ]
}
```

## `card.tsx`

```tsx
export function Card({ title }: { title: string }) {
    return <div>{title}</div>;
}

```

