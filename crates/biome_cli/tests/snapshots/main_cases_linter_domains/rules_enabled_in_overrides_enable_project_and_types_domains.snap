## Command

```shell
biome check src/index.ts
```

## `biome.json`

```json
{
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "correctness": { "noUnresolvedImports": "error" },
          "nursery": { "noFloatingPromises": "error" },
          "suspicious": { "noConsole": "error" }
        }
      }
    }
  ]
}
```

## `src/index.ts`

```ts
import { missing } from "./other.ts";

async function load(): Promise<string> {
	return "data";
}

export function main(): void {
	console.log(missing);
	load();
}

```

