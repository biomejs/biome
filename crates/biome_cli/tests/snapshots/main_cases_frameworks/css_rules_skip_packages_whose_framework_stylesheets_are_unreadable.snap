## Command

```shell
biome lint site/src/styles/partial.css site/src/components/Card.jsx site/src/components/Plain.jsx site/src/pages/index.astro
```

## `biome.json`

```json
{
  "html": { "experimentalFullSupportEnabled": true },
  "linter": {
    "rules": {
      "nursery": {
        "noUndeclaredClasses": "error",
        "noUndeclaredCustomProperties": "error",
        "noUnusedClasses": "error"
      }
    }
  }
}
```

## `site/astro.config.mjs`

```mjs
import { defineConfig } from "astro/config";
import starlight from "@astrojs/starlight";

export default defineConfig({
	integrations: [starlight({ customCss: ["./src/styles/custom.css", "./src/styles/theme.styl"] })],
});

```

