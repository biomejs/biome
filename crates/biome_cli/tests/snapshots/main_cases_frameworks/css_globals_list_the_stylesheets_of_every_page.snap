## `site/src/components/Card.jsx`

```jsx
import "./card.css";

export const Card = () => (
	<div
		className="card card-body sl-flex missing-class"
		style="color: var(--sl-color-text); margin: var(--jsx-missing-space)"
	/>
);

```

