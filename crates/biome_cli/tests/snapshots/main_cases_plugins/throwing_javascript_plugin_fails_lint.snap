## Command

```shell
biome lint '<TEMP_DIR>/throwing_javascript_plugin_fails_lint'
```

## `biome.json`

```json
{ "plugins": ["./rule.js"] }
```

## `main.js`

```js
console.log("hello");

```

## `rule.js`

```js
import { ast, defineRule } from "@biomejs/runtime/plugin";

export default defineRule({
    query: ast("JS_CALL_EXPRESSION"),
    run() {
        throw new Error("boom");
    },
});
```

