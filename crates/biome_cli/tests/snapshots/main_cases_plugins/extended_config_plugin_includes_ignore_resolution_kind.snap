```json
{ "extends": ["./shared/base.json"] }
```

## `plugins/default.grit`

```grit
`Object.assign($args)` where {
    register_diagnostic(span = $args, message = "Default resolutionKind")
}
```

## `plugins/project.grit`

```grit
`Object.assign($args)` where {
    register_diagnostic(span = $args, message = "resolutionKind project")
}
```

## `shared/base.json`

```json
{
    "plugins": [
        { "path": "./plugins/default.grit", "includes": ["src/**"] },
        { "path": "./plugins/project.grit", "resolutionKind": "project", "includes": ["src/**"] },
        { "path": "./plugins/config.grit", "resolutionKind": "config", "includes": ["src/**"] }
    ]
}
```

## `shared/plugins/config.grit`

```grit
`Object.assign($args)` where {
    register_diagnostic(span = $args, message = "resolutionKind config")
}
```

