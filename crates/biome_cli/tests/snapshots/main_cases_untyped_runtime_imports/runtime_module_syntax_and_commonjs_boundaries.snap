## Command

```shell
biome lint --only=correctness/noUnresolvedImports index.mjs meta.js await.js using.js loop.js lexical.js class.js function.js method.js block.js hoisted.js
```

## `biome.json`

```json
{ "linter": { "rules": { "correctness": { "noUnresolvedImports": "error" } } } }
```

## `await.js`

```js
await Promise.resolve();
```

## `block.js`

```js
{ const require = 1; console.log(require); } module.exports = {};
```

## `class.js`

```js
class module {}
```

## `function.js`

```js
async function run() { await Promise.resolve(); } module.exports = { run };
```

## `hoisted.js`

```js
var require = 1; module.exports = {};
```

## `index.mjs`

```mjs
import { absent as missing_meta } from 'meta';
import { absent as missing_await } from 'await';
import { absent as missing_using } from 'using';
import { absent as missing_loop } from 'loop';
import { absent as missing_lexical } from 'lexical';
import { absent as missing_class } from 'class';
import valid_function from 'function'; console.log(valid_function);
import valid_method from 'method'; console.log(valid_method);
import valid_block from 'block'; console.log(valid_block);
import valid_hoisted from 'hoisted'; console.log(valid_hoisted);

```

