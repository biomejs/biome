## Command

```shell
biome lint Component.svelte state.svelte.ts
biome lint --write Component.svelte state.svelte.ts
```

## `biome.json`

```json
{
  "formatter": { "enabled": false },
  "html": {
    "experimentalFullSupportEnabled": true,
    "linter": { "enabled": true }
  },
  "linter": {
    "rules": {
      "preset": "none",
      "complexity": { "noUselessStringConcat": "warn" }
    }
  },
  "assist": { "enabled": false }
}
```

## `Component.svelte`

```svelte
<!-- biome-ignore-start lint/complexity/noUselessStringConcat: intentional concatenation -->
<script context="module">
export const preserved = "a" + "b";
</script>
<!-- biome-ignore-end lint/complexity/noUselessStringConcat: intentional concatenation -->

<script>
const fixed = "cd";
</script>

<p>{preserved}{fixed}</p>

```

