```shell
biome lint runtime-rules.astro
```

## `biome.json`

```json
{
  "html": {
    "experimentalFullSupportEnabled": true,
    "linter": { "enabled": true }
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended",
      "reactNative": "recommended"
    }
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false }
