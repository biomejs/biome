{
  "biome": {},
  "eslint": {
    "rules": {
      "no-unused-vars": ["error", { "ignoreRestSiblings": true }]
    },
    "overrides": [
      {
        "files": ["*.ts"],
        "rules": {
          "no-unused-vars": "off",
          "@typescript-eslint/no-unused-vars": "error"
        }
      }
    ]
  }
}
