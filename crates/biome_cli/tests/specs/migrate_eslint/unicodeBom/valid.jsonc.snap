## Biome Config After Migration

```json
{
	"linter": {
		"rules": {
			"preset": "none",
			"nursery": { "useConsistentUnicodeBom": "error" }
		}
	},
	"overrides": [
		{
			"includes": ["always.js"],
			"linter": {
				"rules": {
					"nursery": {
						"useConsistentUnicodeBom": {
							"level": "warn",
							"options": { "bom": "always" }
						}
					}
				}
			}
		},
		{
			"includes": ["never.js"],
			"linter": {
				"rules": {
					"nursery": {
						"useConsistentUnicodeBom": {
							"level": "error",
							"options": { "bom": "never" }
						}
					}
				}
			}
		},
		{
			"includes": ["off.js"],
			"linter": {
				"rules": {
					"nursery": {
						"useConsistentUnicodeBom": {
							"level": "off",
							"options": { "bom": "always" }
						}
					}
				}
			}
		}
	]
}

```
