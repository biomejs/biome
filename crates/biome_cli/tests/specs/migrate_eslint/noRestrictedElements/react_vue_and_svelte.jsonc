{
  "biome": {},
  "eslint": {
    "rules": {
      "react/forbid-elements": ["warn", {
        "forbid": [
          { "element": "a", "message": "Use Link instead." },
          "button"
        ]
      }],
      "vue/no-restricted-html-elements": [
        "warn",
        { "element": "a", "message": "Use NuxtLink instead." },
        "marquee"
      ],
      "svelte/no-restricted-html-elements": [
        "error",
        { "elements": ["a"], "message": "Use the Svelte link instead." },
        { "elements": ["button"], "message": "Use the Button component instead." },
        "blink"
      ]
    }
  }
}
