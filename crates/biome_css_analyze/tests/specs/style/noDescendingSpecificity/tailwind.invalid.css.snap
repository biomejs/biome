source: crates/biome_css_analyze/tests/spec_tests.rs
expression: tailwind.invalid.css
---
# Input
```css
/* should generate diagnostics */

@utility fade {
  .a .inner {
    color: red;
  }
  .inner {
    color: blue;
  }
}

@variant dark {
  .a .card {
    color: white;
  }
  .card {
    color: black;
  }
}

.btn {
  @variant hover {
    .a &:focus {
      color: red;
    }
    &:focus {
      color: blue;
    }
  }
}

@custom-variant theme-a {
  .a .slot-target {
    color: red;
    @slot;
  }
  .slot-target {
    color: blue;
    @slot;
  }
}

```

