# Input
```css
/* should not generate diagnostics */
:root {
  --theme-color: red;
}

$syntax: "<color>";
@property --registered-color {
  syntax: $syntax;
  inherits: false;
  initial-value: red;
}

$inherits: false;
@function initial-color() {
  @return red;
}

@property --dynamic-registration {
  syntax: "<color>";
  inherits: $inherits;
  initial-value: initial-color();
}

.themed {
  color: var(--theme-color);
  border-color: var(--registered-color);
  background-color: var(--dynamic-registration);
}

@mixin spacing-variables {
  --spacing: 4px;
}

:root {
  @include spacing-variables;

  @each $name in primary, secondary {
    --color-#{$name}: red;
  }
}

@mixin root-scope {
  :root {
    @content;
  }
}

@include root-scope {
  --accent: blue;
}

.mixin-and-interpolated {
  margin: var(--spacing);
  color: var(--color-primary);
  border-color: var(--accent);
}

```
