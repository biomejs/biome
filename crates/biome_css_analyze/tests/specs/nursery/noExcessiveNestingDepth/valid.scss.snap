# Input
```css
/* should not generate diagnostics */
@mixin card {
	.a {
		.b {
			.c {
				.d {
					color: red;
				}
			}
		}
	}
}

.a {
	.b {
		.c {
			.d {
				@include card;
				@extend %placeholder;
				$local: 1px;
			}
		}
	}
}

.a {
	.b {
		@if $x {
			.c {
				color: red;
			}
		} @else if $y {
			.c {
				color: blue;
			}
		} @else {
			.c {
				color: green;
			}
		}
	}
}

.a {
	.b {
		.c {
			.d {
				@extend .icon-#{$name}
			}
		}
	}
}

.a {
	.b {
		.c {
			.d {
				@debug "#{$name}" + #{$size}
			}
		}
	}
}

```
