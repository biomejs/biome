---
source: crates/biome_css_analyze/tests/spec_tests.rs
expression: invalid.css
---
# Input
```css
/* should generate diagnostics */
.a {
	.b {
		.c {
			.d {
				.e {
					color: red;
				}
			}
		}
	}
}

.a {
	.b {
		.c {
			.d {
				@media (min-width: 600px) {
					color: red;
				}
			}
		}
	}
}

.a {
	@media (min-width: 600px) {
		.b {
			@supports (display: grid) {
				.c {
					color: red;
				}
			}
		}
	}
}

.a {
	.b {
		.c {
			@keyframes fade {
				from {
					opacity: 0;
				}
			}
		}
	}
}

.a {
	.b {
		.c {
			.d {
				.e {
					.f {
						color: red;
					}
				}
			}
		}
	}
}

.a {
	.b {
		@MEDIA (min-width: 600px) {
			.c {
				.d {
					color: red;
				}
			}
		}
	}
}

```

