---
source: crates/biome_css_analyze/tests/spec_tests.rs
expression: invalid.scss
---
# Input
```css
/* should generate diagnostics */
$color: red;
.unlayered {
  color: $color;
}

@mixin card {
  .card {
    color: red;
  }
}

@mixin dashed_name {
  .dashed {
    color: red;
  }
}

@include card;
@include dashed-name;

@mixin base-card {
  .base {
    color: red;
  }
}

@mixin wrapped-card {
  @include base-card;
}

@include wrapped-card;

@mixin wrapper {
  @include defined-after;
}

@mixin defined-after {
  .after {
    color: red;
  }
}

@include wrapper;

```

