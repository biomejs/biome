# Input
```css
/* should generate diagnostics */
a {
  @if $x == null {}
}

a {
  @if $x != null {}
}

a {
  @if null == $x {}
}

a {
  @if null != $x {}
}

a {
  @if ($x == null) {}
}

a {
  @if $a == 1 {} @else if $x == null {}
}

a {
  @if $a == 1 {} @else if $x != null {}
}

a {
  @if $y and $x == null {}
}

a {
  @if $y or $x != null {}
}

a {
  @if $x != null or $y {}
}

a {
  @if $y and $x != null {}
}

a {
  @if not ($x == null) {}
}

a {
  @if not $x == null {}
}

a {
  @if $x == null and $x > 1 {}
}

a {
  @if ($x != null or $z) and $y {}
}

a {
  @if map.get($map, "key") == null {}
}

@mixin m($x) {
  @if $x == null {}
}

@function f($x) {
  @if $x != null {
    @return $x;
  }
  @return 0;
}

```

