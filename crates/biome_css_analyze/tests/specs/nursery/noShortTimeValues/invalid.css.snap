a { animation: foo 0.8s ease 0.1s, bar 0.8s ease 0.01s; }

/* Each short time is reported separately. */
a { animation: foo 0.01s ease 0.8s, bar 0.8s ease 0.02s; }
a { transition-duration: 10ms, 200ms, 20ms; }

/* Times inside functions are checked as written. */
a { transition-duration: calc(10ms * 20); }
a { transition-duration: var(--duration, 10ms); }
a { animation: foo max(10ms, var(--duration)); }

@keyframes slide {
	from { animation-duration: 50ms; }
}

@media (prefers-reduced-motion: no-preference) {
	a {
		transition:
			opacity 50ms,
			transform 0.3s;
	}
}

