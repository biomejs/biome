  --controls: #ff0000 #000000;
  --raw: #12px #12unknown #12345 #1234567 #12e3 #-- #app;
  --nested: token(#12unknown [#4566a8]);
  --escaped: #\31 2unknown;
  --interpolated: #12unknown#{suffix} #12#{suffix};
  color: #4566a8;
  width: 12px;
}

@supports (--accent: #4566a8) {
  .supported { --raw: #12unknown; }
}

