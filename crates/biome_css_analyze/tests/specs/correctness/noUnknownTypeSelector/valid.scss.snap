# Input
```css
/* should not generate diagnostics */
@mixin frames {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fade {
  @include frames;
}

@mixin keyframes($name) {
  @keyframes #{$name} {
    @content;
  }
}

@include keyframes(spin) {
  FROM { transform: rotate(0); }
  to { transform: rotate(1turn); }
}

@mixin conditional($fade) {
  @if $fade {
    from { opacity: 0; }
  } @else {
    to { opacity: 1; }
  }
  @each $step in 1 {
    from { opacity: 0; }
  }
}

@mixin loops {
  @for $i from 1 through 2 {
    from { opacity: 0; }
  }
  @while false {
    to { opacity: 1; }
  }
  from, to { opacity: 1; }
}

```
