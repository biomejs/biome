# Input

```js
const fiveSpaceIndent = (data) => `
     ${
       data
       ?`<bar>${data.aBitLongerNameHelpingReproduceThisProblem}</bar>`
       :''
     }
`

const sixSpaceIndent = (data) => `
      ${
       data
       ?`<bar>${data.aBitLongerNameHelpingReproduceThisProblem}</bar>`
       :''
     }
`

```


# Formatted

```js
const fiveSpaceIndent = (data) => `
     ${
				data
					? `<bar>${data.aBitLongerNameHelpingReproduceThisProblem}</bar>`
					: ""
			}
`;

const sixSpaceIndent = (data) => `
      ${
				data
					? `<bar>${data.aBitLongerNameHelpingReproduceThisProblem}</bar>`
					: ""
			}
`;

```
