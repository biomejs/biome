# Formatted

```js
// A key that cannot be written without quotes forces every key to be quoted.
const needsQuotes = { "prop-1": "hello", "prop2": 10, "prop3": false };

// A nested object with no such key keeps its keys unquoted.
const nested = { "prop-1": 1, "prop2": { prop3: 2, prop4: 3 } };

// A nested object with a key that needs quotes quotes all of its keys.
const nestedQuoted = { outer: 1, inner: { "a-b": 2, "c": 3 } };

// No key needs quotes, so this behaves like `as-needed`.
const plain = { prop1: 1, prop2: 2, prop3: 3 };

// Numbers and strings are quoted together with identifiers.
const mixed = { "prop-1": 1, "1": 2, "1.5": 3, "prop2": 4 };

// Methods, getters, and setters share the object's decision.
const members = {
	"prop-1": 1,
	"method"() {},
	get "value"() {
		return 1;
	},
	set "value"(value) {},
};

// Shorthand properties are never quoted.
const shorthand = { "prop-1": 1, prop2 };

// Numeric keys that normalize are quoted in their printed form, while keys
// that keep a distinct spelling stay unquoted.
const numeric = { "a-b": 1, "0.1": 2, "1": 3, 1.0: 4, 0xf: 5 };

// Class members share the class's decision.
class Members {
	"prop-1" = 1;
	"method"() {}
	get "value"() {
		return 1;
	}
	set "value"(value) {}
}

```
