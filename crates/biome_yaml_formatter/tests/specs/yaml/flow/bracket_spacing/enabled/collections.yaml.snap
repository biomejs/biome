pairs: [key: value, ? explicit, : empty]
empty_pair: [ : ]
empty_entry: { : }
explicit: {? key : value}
collection_keys: {[a, b]: value, {a: b}: other}
anchor: &anchor key
aliases: {*anchor : value}
tagged: {key: !!str , !!str : value}
block:
