boundary: [one, two, three, four, five]
long_mapping: {first_key: first_value, second_key: second_value, third_key: third_value, fourth_key: fourth_value}
long_sequence: [first_value, second_value, third_value, fourth_value, fifth_value, sixth_value]

```


