# Input

```yaml
mapping: {
  # before
  first: 1, # between
  second: 2
  # after
}
sequence: [
  # before
  first, # between
  second
  # after
]
empty_mapping: { } # empty
empty_sequence: [ ] # empty

```


# Options

```json
{
  "formatter": {
    "lineWidth": 40
  },
  "yaml": {
    "formatter": {
      "bracketSpacing": true
    }
  }
}
```

# Formatted

```yaml
mapping: {
    # before
    first: 1, # between
    second: 2,
    # after
  }
sequence: [
    # before
    first, # between
    second,
    # after
  ]
empty_mapping: {} # empty
empty_sequence: [] # empty

```
