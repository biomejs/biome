## Source

```ts
export function stringEquals(x: "a" | "b" | "c") {
	if (x === "a") {
		if (x === "b") {
			x;
		}
	}
}

type Choice = { kind: "left"; left: string } | { kind: "right"; right: number };

export function memberEquals(s: Choice) {
	if (s.kind === "left") {
		if (s.kind === "right") {
			s;
		}
	}
}
```

