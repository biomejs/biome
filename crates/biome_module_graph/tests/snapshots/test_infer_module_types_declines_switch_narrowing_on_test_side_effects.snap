# `/src/index.ts`

## Source

```ts
export function precedingCaseTestWrites(x: number | "a") {
	switch (x) {
		case ((x = 5), "nope" as any):
			break;
		case "a":
			x;
			break;
	}
}

type Kinded = { kind: "a"; a: number } | { kind: "b"; b: number };

export function precedingCaseTestWritesMember(y: Kinded) {
	switch (y.kind) {
		case ((y.kind = "a"), "zzz" as any):
			break;
		case "b":
			y;
			break;
	}
}
```

