export function typeofThenTruthy(x: string | undefined) {
	if (typeof x === "undefined") {
		if (x) {
			x;
		}
	}
}

export function typeofThenTruthyKeepsSubset(y: string | Promise<void>) {
	if (typeof y === "string") {
		if (y) {
			y;
		}
	}
}

export function truthyThenTypeof(z: string | Promise<void>) {
	if (z) {
		if (typeof z === "string") {
			z;
		}
	}
}
