# `/src/index.ts`

## Source

```ts
let promise: Promise<void> | undefined;

async function sleep(): Promise<void> {
	return;
}

export async function consume() {
	if (!promise) {
		promise = sleep();
	}

	const awaited = await promise;
	return awaited;
}
```

