# `/src/index.ts`

## Source

```ts
type Mapper<T> = () => T;

declare function mapAliased<T>(mapper: Mapper<T>): T;
declare function mapInline<T>(mapper: () => T): T;

export const aliased = mapAliased(() => 42);
export const inline = mapInline(() => 42);
```

