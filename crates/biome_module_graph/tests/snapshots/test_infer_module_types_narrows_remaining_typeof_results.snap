# `/src/index.ts`

## Source

```ts
export function booleanGuard(b: boolean | string) {
	if (typeof b === "boolean") {
		b;
	}
}

export function bigintGuard(n: bigint | string) {
	if (typeof n === "bigint") {
		n;
	}
}

export function symbolGuard(s: symbol | string) {
	if (typeof s === "symbol") {
		s;
	}
}

export function numberGuard(v: number | string) {
	if (typeof v === "number") {
		v;
	}
}
```

