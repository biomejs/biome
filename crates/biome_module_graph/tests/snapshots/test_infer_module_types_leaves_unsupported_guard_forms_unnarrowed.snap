# `/src/index.ts`

## Source

```ts
export function negated(x: number | string) {
	if (typeof x !== "string") {
		x;
	}
}

export function conjunction(x: number | string) {
	if (typeof x === "string" && x.length > 0) {
		x;
	}
}

export function elseBranch(x: number | string) {
	if (typeof x === "string") {
		x.length;
	} else {
		x;
	}
}

export function afterGuard(x: number | string) {
	if (typeof x === "string") {
		x.length;
	}
	x;
}
```

