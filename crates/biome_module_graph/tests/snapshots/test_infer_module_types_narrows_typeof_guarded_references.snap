# `/src/index.ts`

## Source

```ts
export function guarded(x: number | (() => Promise<void>)) {
	if (typeof x === "function") {
		x;
	}
	x;
}

export function reversed(y: string | undefined) {
	if (typeof y === "undefined") {
		y;
	}
	if ("string" == typeof y) {
		y;
	}
}
```

