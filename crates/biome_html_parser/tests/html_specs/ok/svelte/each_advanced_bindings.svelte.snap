## Input

```svelte
<script lang="ts">
	const ids = [];
	const objects = [];
	const values = [];
	type Value = number;
	type Item = { id: number };
	type Pair<A, B> = [A, B];
</script>

{#each ids as id}
	{#each objects as { [id]: value }}
		<p>{value}</p>
	{/each}
{/each}

{#each objects as { list: [first, ...rest] }}
	<p>{first}: {rest}</p>
{/each}

{#each objects as { [ids[0]]: [computedFirst, computedSecond] }}
	<p>{computedFirst}: {computedSecond}</p>
{/each}

{#each values as [first, second, ...[third, ...{ length }]]}
	<p>{first}{second}{third}{length}</p>
{/each}

{#each values as [head, ...{ length }]}
	<p>{head}{length}</p>
{/each}

{#each values as value: Value, index (value)}
	<p>{index}: {value}</p>
{/each}

{#each objects as { id }: Item}
	<p>{id}</p>
{/each}

{#each values as value: Pair<string, number>, index (value)}
	<p>{index}: {value}</p>
{/each}

```


