</template>

<template title="lang=pug">
	<div class="markup">still markup</div>
</template>

<template :lang="dynamic">
	<div class="markup">still markup</div>
</template>

<template v-bind:lang="dynamic">
	<div class="markup">still markup</div>
</template>

