[
	// valid

	"({ a: 1, b: 1 });",
	"({ '': 1, ' ': 1 });",
	"({ 012: 1, 12: 1 });",
	"({ 1_0: 1, 1: 1 });",
	"({ a: 1, [a]: 1 });",
	"({ [a]: 1, [a]: 1 });",
	"({ get a() {}, set a(v) {} });",
	"({ a: 1, ...a });",
	"({ a: 1, b: { a: 1, b: 1 } });",

	// Not object keys, so out of scope for this rule
	"var { a, a } = obj;"
]
