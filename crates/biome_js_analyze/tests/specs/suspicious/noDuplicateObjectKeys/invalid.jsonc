[
	"({ a: 1, a: 2 });",
	"({ a: 1, a: 2, a: 3 });",
	"({ '': 1, '': 2 });",
	"({ z: 1, z: 2 });",
	"({ get a() {}, get a() {} });",
	"({ set a(v) {}, set a(v) {} });",
	"({ a: 1, get a() {} });",
	"({ a: 1, set a(v) {} });",
	"({ get a() {}, a: 1 });",
	"({ set a(v) {}, a: 1 });",
	"({ a: 1, get a() {}, set a(v) {} });",
	"({ get a() {}, a: 1, set a(v) {} });",
	"({ get a() {}, set a(v) {}, a: 1 });",
	// computed property
    "({ a: 1, ['a']: 1 });",
	// equivalent numeric property names
	"({ 0x1: 1, 1: 2 });",
	"({ 012: 1, 10: 2 });",
	"({ 0b1: 1, 1: 2 });",
	"({ 0o1: 1, 1: 2 });",
	"({ 1_0: 1, 10: 2 });",
	"({ 1.0: 1, 1: 2 });",
	"({ '1': 1, 1: 2 });",
	"({ 0x1: 1, 1.0: 2, '1': 3 });",
	"({ [0x1]: 1, [1]: 2 });"
]
