# Input
```ts
/* should generate diagnostics */

const letters = ["A", "B", "C"] as const;
type Letter = (typeof letters)[number];

function check(letter: Letter) {
	if (letter) {}
	return letter ?? "A";
}

function unreachable(letter: Letter) {
	switch (letter) {
		case "D": break;
	}
}

const values = { A: 1, B: 2, C: 3 } as const;
function checkKey(key: keyof typeof values) {
	if (key) {}
}

```

# Diagnostics
```
indexedAccessInvalid.ts:7:6 lint/suspicious/noUnnecessaryConditions ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ! This condition is always truthy.
  
    6 │ function check(letter: Letter) {
  > 7 │ 	if (letter) {}
      │ 	    ^^^^^^
    8 │ 	return letter ?? "A";
    9 │ }
  
  i The value's type can never be falsy, so this check is redundant.
  

```

```
indexedAccessInvalid.ts:8:9 lint/suspicious/noUnnecessaryConditions ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ! Unnecessary nullish coalescing.
  
     6 │ function check(letter: Letter) {
     7 │ 	if (letter) {}
   > 8 │ 	return letter ?? "A";
       │ 	       ^^^^^^
     9 │ }
    10 │ 
  
  i Drop ?? and the fallback expression.
  
     6 │ function check(letter: Letter) {
     7 │ 	if (letter) {}
   > 8 │ 	return letter ?? "A";
       │ 	              ^^
     9 │ }
    10 │ 
  
  i The left-hand side is guaranteed to be non-nullish, so the fallback is unreachable.
  

```

