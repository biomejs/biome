# Input
```js
/* should generate diagnostics */

try {
  throw new Error("Original error");
} catch (err) {
  throw new Error("Wrapper error");
}


try {
  throw new Error("Original error");
} catch (err) {
  throw new Error(`Failed: ${err.message}`);
}

try {
  throw new Error("Original error");
} catch (err) {
  if (true) {
    throw err;
  }
}

try {
	doSomething();
} catch {
	throw new TypeError("Something went wrong");
}


try {
  throw new Error("Original error");
} catch ({ message }) {
  throw new Error(message);
}


try {
  throw new Error("Original error");
} catch (err) {
  throw new Error(`Failed to process: ${err.message}`, { cause: err.message });
}

try {
    doSomething();
} catch (error) {
    if (whatever) {
        const error = anotherError; // This declaration is the problem.
        throw new Error("Something went wrong", { cause: error });
    }
}

try {
    doSomething();
} catch (err) {
	throw new Error("", { cause: otherVar });
}


```

# Diagnostics
```
invalid.js:6:3 lint/style/useErrorCause ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i The original error is not passed to the new `Error` object.
  
    4 │   throw new Error("Original error");
    5 │ } catch (err) {
  > 6 │   throw new Error("Wrapper error");
      │   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    7 │ }
    8 │ 
  
  i Without the original error as its `cause`, the stack trace and context of the first failure are lost. This makes the failure harder to trace.
  
  i Pass the original error in the `cause` option, for example `new Error("message", { cause: error })`.
  

```

