// should not generate diagnostics
export function whileBreak(stop) { while (true) { if (stop) break; } return 1; }
export function doWhileBreak(stop) { do { if (stop) break; } while (true); return 1; }
export function labeledBreak(stop) { outer: while (true) { while (true) { if (stop) break outer; } } return 1; }
export function labeledDoBreak(stop) { outer: do { while (stop) { break outer; } } while (true); return 1; }
