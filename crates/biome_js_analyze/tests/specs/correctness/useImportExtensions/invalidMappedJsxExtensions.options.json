{
  "linter": {
    "rules": {
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "extensionMappings": {
              "js": "ts",
              "jsx": "ts",
              "tsx": "ts"
            },
            "forceJsExtensions": false
          }
        }
      }
    }
  }
}
