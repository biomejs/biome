	if (this === undefined) {}
}

{
	if (a.b.c === 1) {}
	if (a.b.c === 2) {}
}

switch (x) {
	case "a":
		if (foo === 1) {}
		if (foo === 2) {}
		if (foo === 3) {}
}

{
	if (foo === 1) {
		bar();
	}

	if (foo === 2) {}
}

