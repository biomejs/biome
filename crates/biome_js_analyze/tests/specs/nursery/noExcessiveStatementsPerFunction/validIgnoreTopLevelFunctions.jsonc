[
	"/* should not generate diagnostics */ (function() { var bar = 1; return function () { return 42; }; })()",
	"/* should not generate diagnostics */ function foo() { var bar = 1; var baz = 2; }",
	"/* should not generate diagnostics */ define(['foo', 'qux'], function(foo, qux) { var bar = 1; var baz = 2; })",
	"/* should not generate diagnostics */ function top_level() { 1; class C { static { one; two; three; { four; five; six; } } } 3; }",
	"/* should not generate diagnostics */ function top_level() { 1; 2; } class C { static { one; two; three; { four; five; six; } } }",
	"/* should not generate diagnostics */ class C { static { one; two; three; { four; five; six; } } } function top_level() { 1; 2; }"
]
