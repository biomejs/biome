---
source: crates/biome_js_analyze/tests/spec_tests.rs
expression: invalid.js
---
# Input
```js
/* should generate diagnostics */
import { createApp, defineComponent, watch, watchEffect } from "vue";

defineComponent({
	setup: async function () {
		await doSomething();
		watch(source, () => {});
	},
});

defineComponent({
	setup: async () => {
		await doSomething();
		watchEffect(() => {});
	},
});

createApp({
	async setup() {
		await doSomething();
		watch(source, () => {});
	},
});

// Each watcher after the first `await` is reported.
defineComponent({
	async setup() {
		await doSomething();
		watch(source, () => {});
		await doSomething();
		watch(source, () => {});
	},
});

// The `await` is inside a block that comes before the watcher.
defineComponent({
	async setup() {
		if (shouldLoad) {
			await doSomething();
		}
		watchEffect(() => {});
	},
});

// The `await` is in the arguments of an earlier call.
defineComponent({
	async setup() {
		const data = useData(await doSomething());
		watchEffect(() => {});
	},
});

// The watcher is created after its argument is awaited.
defineComponent({
	async setup() {
		watch(await loadSource(), () => {});
	},
});

defineComponent({
	async setup() {
		for await (const item of items) {
			watch(item, () => {});
		}
		watchEffect(() => {});
	},
});

```

# Diagnostics
```
invalid.js:7:3 lint/nursery/noVueWatchAfterAwait ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  × This watcher is created after an await, so it keeps running after the component is removed.
  
    5 │ 	setup: async function () {
    6 │ 		await doSomething();
  > 7 │ 		watch(source, () => {});
      │ 		^^^^^^^^^^^^^^^^^^^^^^^
    8 │ 	},
    9 │ });
  
  i The setup() function pauses here. After this point, Vue no longer knows which component the watcher belongs to.
  
    4 │ defineComponent({
    5 │ 	setup: async function () {
  > 6 │ 		await doSomething();
      │ 		^^^^^
    7 │ 		watch(source, () => {});
    8 │ 	},
  
  i Create the watcher before the first await in setup(), or store the function it returns and call that function to stop the watcher.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

```

