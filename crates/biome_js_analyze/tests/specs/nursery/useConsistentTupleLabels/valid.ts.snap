// Optional elements without labels
type E1 = [string?, number?];

// Rest elements
type F1 = [a: string, ...b: number[]];
type F2 = [string, ...number[]];
type F3 = [...rest: string[]];

// Nested tuples are checked on their own
type G1 = [[a: number, b: number]];
type G2 = [a: [x: number], b: [y: number]];
type G3 = [a: [number, number], b: [string]];

// Not a tuple
