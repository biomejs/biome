---
source: crates/biome_js_analyze/tests/spec_tests.rs
expression: invalid-to-refs.js
---
# Input
```js
/* should generate diagnostics */
import { toRefs } from 'vue'
const { count } = toRefs(foo)
const value1 = count.value
const { value: value2 } = count
const value3 = fn(count.value)

const refs = toRefs(foo)
const value4 = refs.count.value
const { value: value5 } = refs.count
const value6 = fn(refs.count.value)

const { foo: renamed = 42, nested: { value: value7 }, ...rest } = refs
const value8 = renamed.value
const value9 = rest.other.value

let assigned
let assignedRest
;({ assigned, ...assignedRest } = toRefs(foo))
const value10 = assigned.value
const value11 = assignedRest.other.value

```

# Diagnostics
```
invalid-to-refs.js:4:16 lint/nursery/noVueRefObjectReactivityLoss ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ! This reads the value of a ref only once, so it won't update when the ref changes.
  
    2 │ import { toRefs } from 'vue'
    3 │ const { count } = toRefs(foo)
  > 4 │ const value1 = count.value
      │                ^^^^^^^^^^^
    5 │ const { value: value2 } = count
    6 │ const value3 = fn(count.value)
  
  i This code runs only once, together with the code that creates the ref. The value read here is a copy, and Vue does not update it when the ref changes.
  
  i Read .value inside a function, such as a computed() getter, or pass the ref itself instead of its value.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

```

