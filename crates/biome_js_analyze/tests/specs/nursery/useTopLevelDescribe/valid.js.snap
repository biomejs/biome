	});

	test.describe("another test suite", () => {
		test("my other test", async ({ page }) => {});
	});
});

test.describe.serial("test suite", () => {
	test("my test", async ({ page }) => {});
});

test.describe.parallel.only("test suite", () => {
	test("my test", async ({ page }) => {});
});

test.describe.configure({ mode: "parallel" });
test.use({ locale: "en-GB" });

const it2 = test.extend({});

// A step is a part of a test, and can be written in a helper function.
async function login(page) {
	await test.step("log in", async () => {});
	await test.step.skip("log out", async () => {});
}

// Playwright annotations change how tests run, but they don't declare a test.
test.skip(({ browserName }) => browserName !== "chromium", "Chromium only");
test.fixme(isMobile, "Not ready for mobile");

async function skipWithoutCredentials() {
	test.skip(!process.env.USER, "No credentials");
	test.fixme();
}

// Deno's built-in test runner has no describe blocks.
Deno.test("my test", () => {});

// A table without the call that declares the test
it.each();
it.each([1, 2, 3]);

// Not tests
foo();
const tail$ = source$.pipe(skip(1));
foo.test("my test", () => {});
foo.beforeEach(() => {});
/a/.test("my test");
jest.doMock("my-module");

