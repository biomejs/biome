  <div :class="[...['w-4 h-4']]" />
  <div :class="{...{'px-2 py-2': active}}" />
  <div :class="cached = 'w-4 h-4'" />
  <div :class="cached += ' w-4 h-4'" />
  <div :class="cached ??= 'w-4 h-4'" />
</template>

