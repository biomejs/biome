# Input
```svelte
<!-- should generate diagnostics -->
<script>
const width = window.innerWidth;
const element = document.createElement("div");
const theme = localStorage.getItem("theme");
globalThis.document.title;
globalThis["window"].innerWidth;
window?.innerWidth;
if (typeof window === "undefined") { document.title; }
if (typeof localStorage !== "undefined") { document.title; }
if (typeof window !== "undefined" || ready) { document.title; }
if (typeof window === "undefined" && document.title) {}
if (typeof window.foo !== "undefined") { document.title; }
const obj = { [window.name]() {} };
class Component { static width = window.innerWidth; }
const globals = { window, document };
window = {};
</script>

```

