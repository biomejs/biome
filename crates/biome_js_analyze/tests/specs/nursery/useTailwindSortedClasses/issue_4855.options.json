{
  "$schema": "../../../../../../packages/@biomejs/biome/configuration_schema.json",
  "tailwind": {
    "attributes": [
      "class",
      "className",
      "customClassAttribute"
    ],
    "mergeFunctions": [
      "clsx",
      "tw"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double"
    }
  },
  "linter": {
    "rules": {
      "nursery": {
        "useTailwindSortedClasses": "error"
      }
    }
  }
}
