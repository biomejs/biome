# Input
```js
/* should generate diagnostics */
var foo = fs.fooSync();
var foo = fooSync();
var foo = fs.fooSync.apply();
var foo = fooSync.apply();
var foo = fooSync.call(null, "path");
var foo = fs?.fooSync();
