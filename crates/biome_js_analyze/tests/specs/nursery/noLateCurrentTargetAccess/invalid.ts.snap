source: crates/biome_js_analyze/tests/spec_tests.rs
expression: invalid.ts
---
# Input
```ts
/* should generate diagnostics */

// A parameter with an event type
async function f(event: Event) {
	await y();
	event.currentTarget;
}

// An event type decides, even when the name doesn't look like an event
async function f(click: MouseEvent) {
	await y();
	click.currentTarget;
}

// A React event type
import type { SyntheticEvent } from "react";
async function f(target: SyntheticEvent) {
	await y();
	target.currentTarget;
}

// A type assertion still refers to the event
el.addEventListener("click", async (e) => {
	await x;
	(e as Event).currentTarget;
});

// A non-null assertion still refers to the event
el.addEventListener("click", async (e) => {
	await x;
	e!.currentTarget;
});

// A `satisfies` expression still refers to the event
el.addEventListener("click", async (event) => {
	await x;
	(event satisfies Event).currentTarget;
});

// A type assertion with optional chaining
el.addEventListener("click", async (event) => {
	await x;
	(event as Event)?.currentTarget;
});

// A type assertion in a nested function
el.addEventListener("click", (e) => {
	setTimeout(() => (e as Event).currentTarget);
});

```

# Diagnostics
```
invalid.ts:6:2 lint/nursery/noLateCurrentTargetAccess ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ! event.currentTarget is read after the event handler pauses.
  
    4 │ async function f(event: Event) {
    5 │ 	await y();
  > 6 │ 	event.currentTarget;
      │ 	^^^^^^^^^^^^^^^^^^^
    7 │ }
    8 │ 
  
  i The event handler pauses here.
  
    3 │ // A parameter with an event type
    4 │ async function f(event: Event) {
  > 5 │ 	await y();
      │ 	^^^^^^^^^
    6 │ 	event.currentTarget;
    7 │ }
  
  i When the handler pauses, the browser finishes handling the event and sets currentTarget to null.
  
  i Save event.currentTarget to a variable before the event handler pauses, and use that variable instead.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

```

