invalid.js:6:2 lint/nursery/noLateCurrentTargetAccess ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  ! event.currentTarget is read after the event handler pauses.
  
    4 │ element.addEventListener("click", async (event) => {
    5 │ 	await somePromise;
  > 6 │ 	event.currentTarget.disabled = false;
      │ 	^^^^^^^^^^^^^^^^^^^
    7 │ });
    8 │ 
  
  i The event handler pauses here.
  
    3 │ // After `await`
    4 │ element.addEventListener("click", async (event) => {
  > 5 │ 	await somePromise;
      │ 	^^^^^^^^^^^^^^^^^
    6 │ 	event.currentTarget.disabled = false;
    7 │ });
  
  i When the handler pauses, the browser finishes handling the event and sets currentTarget to null.
  
  i Save event.currentTarget to a variable before the event handler pauses, and use that variable instead.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

```

