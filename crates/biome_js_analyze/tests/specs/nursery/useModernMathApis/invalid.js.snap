function logarithm(x) {
    return Math.log(x) / Math.LN10;
}

Math.sqrt(a * a + b * b);
Math.sqrt(a ** 2 + b ** 2);
Math.sqrt(a * a + b ** 2);
Math.sqrt(a * a + b * b + c * c);
Math.sqrt(a ** 2 + b ** 2 + c ** 2);
Math.sqrt(a * a);
Math.sqrt(a ** 2);
Math.sqrt(a * a,);
Math.sqrt(a ** 2,);
Math.sqrt((a, b) ** 2);
Math.sqrt((++a) ** 2);
Math.sqrt(a * a + b * b,);
Math.sqrt(a ** 2 + b ** 2,);
