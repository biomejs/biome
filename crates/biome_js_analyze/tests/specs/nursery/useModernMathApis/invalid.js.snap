Math.sqrt(0x2 * 2);
Math.sqrt("x" * 'x');

class Vector {
    #x;

    magnitude() {
        return Math.sqrt(this.#x * this.#x);
    }
}

/* leading logarithm comment */ Math.log(x) * Math.LOG10E; /* trailing logarithm comment */
/* leading square root comment */ Math.sqrt(a * a + b * b); /* trailing square root comment */

