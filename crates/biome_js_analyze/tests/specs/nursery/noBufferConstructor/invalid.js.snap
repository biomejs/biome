new Buffer([1, 2, 3]);
Buffer(5);
Buffer([1, 2, 3]);
new Buffer(res.body.amount);
new Buffer(res.body.values);
new (Buffer)(5);
new globalThis.Buffer(5);
window.Buffer(5);
globalThis["Buffer"](5);
new Buffer;
new global.Buffer(5);
self.Buffer(5);

```

