---
source: crates/biome_js_analyze/tests/spec_tests.rs
expression: invalid.js
---
# Input
```js
/* should generate diagnostics */
import { useMutation, useMutation as useSave } from "@tanstack/react-query";
import { useMutation as useVueMutation } from "@tanstack/vue-query";

useMutation({
	mutationFn: (todo) => saveTodo(todo),
	onError: (error, todo, saved) => restoreTodo(saved.previous),
	onMutate: (todo) => ({ previous: readTodo(todo.id) }),
	retry: 3,
});

useSave({
	onSettled: (data, error, todo, saved) => refreshTodo(saved.previous),
	gcTime: 5 * 60 * 1000,
	onMutate: (todo) => ({ previous: readTodo(todo.id) }),
});

useVueMutation({
	onError,
	onSettled,
	onMutate,
});

useMutation({
	onSettled,
	onMutate,
	onError,
});

useMutation({
	onError() {},
	"onMutate": () => {},
});

useMutation({
	"onSettled": () => {},
	async onMutate() {},
});

useMutation({
	onError,
	["onMutate"]: () => {},
});

useMutation(({
	// Roll back the change.
	onError, // rollback
	// Remember the previous value.
	onMutate, // snapshot
}), queryClient);

useMutation({ onError, onMutate });

useMutation({ onError, gcTime, onMutate, });

useMutation({
	onError,
	onMutate
});

useMutation({
	onError,
	...sharedOptions,
	onMutate,
});

useMutation({
	onMutate: first,
	onError,
	onMutate: second,
});

function Component() {
	return useMutation({
		onSettled,
		onMutate,
	});
}

useMutation({ mutationFn,
	onError,
	onMutate });

useMutation({
	mutationFn, // send the request
	onError, onMutate,
});

useMutation({ onError,
	onMutate, // snapshot
});

useMutation({ onError, onMutate // snapshot
});

useMutation({
	onError, gcTime, // cache
	onMutate, retry });

```

# Diagnostics
```
invalid.js:8:2 lint/nursery/useTanstackQueryMutationPropertyOrder  FIXABLE  ━━━━━━━━━━━━━━━━━━━━━━━━

  ! This onMutate property comes after onError.
  
     6 │ 	mutationFn: (todo) => saveTodo(todo),
     7 │ 	onError: (error, todo, saved) => restoreTodo(saved.previous),
   > 8 │ 	onMutate: (todo) => ({ previous: readTodo(todo.id) }),
       │ 	^^^^^^^^
     9 │ 	retry: 3,
    10 │ });
  
  i TanStack Query passes the value that onMutate returns to onError and onSettled. The type of that value is worked out from the properties in the order in which they are written, so it can be wrong in a property that comes before onMutate.
  
  i Move onMutate before onError and onSettled.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  
  i Unsafe fix: Move onMutate before onError.
  
     5  5 │   useMutation({
     6  6 │     mutationFn: (todo) => saveTodo(todo),
     7    │ - → onError:·(error,·todo,·saved)·=>·restoreTodo(saved.previous),
     8    │ - → onMutate:·(todo)·=>·({·previous:·readTodo(todo.id)·}),
        7 │ + → onMutate:·(todo)·=>·({·previous:·readTodo(todo.id)·}),
        8 │ + → onError:·(error,·todo,·saved)·=>·restoreTodo(saved.previous),
     9  9 │     retry: 3,
    10 10 │   });
  

