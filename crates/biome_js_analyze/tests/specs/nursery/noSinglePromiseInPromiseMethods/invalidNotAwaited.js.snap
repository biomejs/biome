foo(Promise.any([promise]));
Promise.race([promise]).foo = 1;
typeof (Promise).race([object.value]);
delete Promise.any([object.value]);
Promise["race"]([promise]);
Promise.race([function () {}]);
Promise.race([class {}]);

```

