  ! Avoid calling .filter() on a Convex database query.
  
    3 │ async function typeWrappers(ctx: QueryCtx) {
  > 4 │ 	await (ctx.db as DatabaseReader).query("messages").filter((q) => q.eq(q.field("read"), false)).collect();
