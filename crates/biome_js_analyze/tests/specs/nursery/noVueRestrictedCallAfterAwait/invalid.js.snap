# Input
```js
/* should generate diagnostics */
import { createApp, defineComponent } from "vue";
import { useI18n } from "vue-i18n";

defineComponent({
	setup: async function () {
		await doSomething();
		useI18n();
	},
});

defineComponent({
	setup: async () => {
		await doSomething();
		useI18n();
	},
});

createApp({
	async setup() {
		await doSomething();
		useI18n();
	},
});

// The `await` is inside a block that comes before the call.
defineComponent({
	async setup() {
		if (shouldLoad) {
			await doSomething();
		}
		useI18n();
	},
});

defineComponent({
	async setup() {
		for await (const item of items) {
		}
		useI18n();
	},
});

```

# Diagnostics
```
invalid.js:8:3 lint/nursery/noVueRestrictedCallAfterAwait ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  × This call to useI18n() from vue-i18n comes after an await in setup().
  
     6 │ 	setup: async function () {
     7 │ 		await doSomething();
   > 8 │ 		useI18n();
       │ 		^^^^^^^^^
     9 │ 	},
    10 │ });
  
  i The setup() function pauses here. After this point, Vue no longer knows which component is being set up.
  
    5 │ defineComponent({
    6 │ 	setup: async function () {
  > 7 │ 		await doSomething();
      │ 		^^^^^
    8 │ 		useI18n();
    9 │ 	},
  
  i This function is listed in the functions option because it needs to know which component is being set up. Call it before the first await in setup().
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

