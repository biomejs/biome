if (!map.has(key)) { map.set(anotherKey, value); }
if (map.has(key)) {} else { map.get(anotherKey); }
if (!map.has(key)) {} else { map.get(anotherKey); }
if (map.has(key)) map.get(anotherKey);
if ((map.has(key))) { (map).get(anotherKey); }

// Nested code that still runs because of the check
