---
source: crates/biome_js_analyze/tests/spec_tests.rs
expression: invalid.js
---
# Input
```js
/* should generate diagnostics */

import { db } from "./db";

// query on the database object inside the callback
await db.transaction(async (tx) => {
	await db.insert(users).values({ name: "John" });
});

// non-async callback
db.transaction(function () {
	return db.select().from(users);
});

// passed as an argument
await db.transaction(async (tx) => {
	await createUser(db, "John");
});

// passed as a shorthand property
await db.transaction(async (tx) => {
	await createUser({ db, name: "John" });
});

// inside a nested function
await db.transaction(async (tx) => {
	await Promise.all(ids.map((id) => db.delete(users).where(eq(users.id, id))));
});

// nested transaction started on the database object
await db.transaction(async (tx) => {
	await db.transaction(async (tx2) => {});
});

// inside a nested transaction started on the transaction object
await db.transaction(async (tx) => {
	await tx.transaction(async (tx2) => {
		await db.select().from(users);
	});
});

// any configured object name, declared outside the file
await database.transaction(async (tx) => {
	await database.select().from(users);
});

```

# Diagnostics
```
invalid.js:7:8 lint/nursery/noDrizzleDbObjectInsideTransaction ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i db is used inside db.transaction().
  
    5 │ // query on the database object inside the callback
    6 │ await db.transaction(async (tx) => {
  > 7 │ 	await db.insert(users).values({ name: "John" });
      │ 	      ^^
    8 │ });
    9 │ 
  
  i Queries made with db run outside the transaction, so they aren't rolled back with it and can deadlock waiting for its locks.
  
  i Use the transaction object passed to the callback instead.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

```

