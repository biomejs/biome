invalid.ts:7:16 lint/nursery/noUnsafeSqliteInterpolation ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  × This SQL string passed to exec() inserts values with ${}.
  
    5 │ {
    6 │ 	const database = new DatabaseSync(":memory:");
  > 7 │ 	database.exec(`SELECT ${id}` as string);
      │ 	              ^^^^^^^^^^^^^^^^^^^^^^^^
    8 │ 	database.exec(<string>`SELECT ${id}`);
    9 │ 	database.exec<string>(`SELECT ${id}`);
  
  i Inserted values become part of the SQL code, so a value that contains SQL can change what the query does. This is called SQL injection.
  
  i Write a ? placeholder in the SQL string, and pass the values when you run the prepared statement, for example database.prepare("SELECT * FROM users WHERE id = ?").get(id).
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

