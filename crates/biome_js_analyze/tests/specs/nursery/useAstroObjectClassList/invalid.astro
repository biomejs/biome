---
// should generate diagnostics
const active = true;
const size = "large";
---
<div class:list={active ? "active" : ""}></div>
<div class:list={active ? "" : "inactive"}></div>
<div class:list={active ? "active" : "inactive"}></div>
<div class:list={[size, active ? "selected" : ""]}></div>
<div class:list={[[active ? "nested" : ""]]}></div>
<div class:list={[(active ? "wrapped" : "")]}></div>
<div class:list={(active ? "root" : "")}></div>
<div class:list={[[(active && size ? "" : "inactive")]]}></div>
<div class:list={active /* keep */ ? "commented" : ""}></div>
<div class:list={active ? "__proto__" : ""}></div>
<div class:list={active ? "\x5f\x5fproto__" : ""}></div>
<div class:list={active ? 'say "hi"' : ""}></div>
<div class:list={active ? 'it\'s' : ""}></div>
<div class:list={active ? 'line\nbreak' : ""}></div>
<div class:list={active ? 'caf\u00e9' : ""}></div>
<div class:list={active ? "\\08" : ""}></div>
