# Input
```js
/* should generate diagnostics */
fetch(url, { body });
new Request(url, { body });
fetch(url, { method: "GET", body });
new Request(url, { method: "GET", body });
fetch(url, { method: "HEAD", body });
new Request(url, { method: "HEAD", body });
fetch(url, { method: "head", body });
new Request(url, { method: "head", body });
fetch(url, { method: `get`, body });
fetch(url, { method: true ? "GET" : "POST", body });
new Request(url, { method: false ? "POST" : "HEAD", body });
const condition = true;
let value;
fetch(url, { method: condition ? "GET" : value, body });
const method = "head";
new Request(url, { method, body: "foo=bar" });
fetch(url, { method, body: "foo=bar" });
const aliasedMethod = method;
fetch(url, { method: aliasedMethod, body: "foo=bar" });
fetch(url, { body }, extraArgument);
new Request(url, { body }, extraArgument);
fetch(url, { body: undefined, body: "foo=bar" });
new Request(url, { body: undefined, body: "foo=bar" });
fetch(url, { method: "post", body: "foo=bar", method: "HEAD" });
new Request(url, { method: "post", body: "foo=bar", method: "HEAD" });
fetch(url, { ["method"]: "GET", "body": "x" });
fetch(url, { ["body"]: "x" });
fetch(url, { [`body`]: "x", method: "GET" });
fetch(url, { body: "x", [`method`]: "GET" });
fetch(url, { ...options, method: "GET", body: "x" });
fetch(url, { ...options, body: "x", method: "GET" });
fetch(url, ({ body: "x" }));
globalThis.fetch(url, { body: "x" });
window.fetch(url, { body: "x" });
new globalThis.Request(url, { body: "x" });
fetch?.(url, { body: "x" });
await fetch(url, { body: "x" });
fetch(url, { method: 0 ? "POST" : "GET", body });
fetch(url, { method: 0.0 ? "POST" : "GET", body });
fetch(url, { method: 0x0 ? "POST" : "GET", body });
fetch(url, { method: 1n ? "GET" : "POST", body });
fetch(url, { body() {} });
fetch(url, { get body() { return "x"; } });

