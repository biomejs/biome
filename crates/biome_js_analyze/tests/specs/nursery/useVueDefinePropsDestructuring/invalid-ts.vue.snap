  i Default values for props are set with withDefaults() instead of in the destructuring.
  
    5 │ const imported = defineProps<Props>();
    6 │ const propsWithDefaults = withDefaults(defineProps<{ foo?: string }>(), { foo: 'default' });
  > 7 │ const { foo } = withDefaults(defineProps<{ foo?: string }>(), { foo: 'default' });
