invalid.vue:5:17 lint/nursery/useVueDefinePropsDestructuring ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i Default values for props are set with withDefaults() instead of in the destructuring.
  
    3 │ const props = defineProps(['foo']);
    4 │ const propsWithDefaults = withDefaults(defineProps(['foo']), { foo: 'default' });
  > 5 │ const { foo } = withDefaults(defineProps(['foo']), { foo: 'default' });
      │                 ^^^^^^^^^^^^
    6 │ withDefaults(defineProps(['foo']), { foo: 'default' });
    7 │ const [first] = defineProps(['foo']);
  
  i With destructuring, each default value sits next to the variable that holds the prop, so withDefaults() isn't needed.
  
  i Remove withDefaults() and give each prop its default value in the destructuring, for example const { foo = "default" } = defineProps(...).
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

```

