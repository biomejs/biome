```
invalid.tsx:13:27 lint/nursery/noMisusedSpread ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i Spreading a class instance into an object loses the methods of its class.
  
    11 │ const fromPromise = <div {...promise} />;
    12 │ 
  > 13 │ const fromDate = <div {...new Date()} />;
       │                           ^^^^^^^^^^
