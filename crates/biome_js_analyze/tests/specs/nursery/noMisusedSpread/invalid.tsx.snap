# Input
```tsx
/* should generate diagnostics */
const fromArray = <div {...[1, 2, 3]} />;

class Component {}
const fromClass = <div {...Component} />;

declare const map: Map<string, number>;
const fromMap = <div {...map} />;

const promise = new Promise(() => {});
const fromPromise = <div {...promise} />;

const fromDate = <div {...new Date()} />;

```

# Diagnostics
```
invalid.tsx:2:28 lint/nursery/noMisusedSpread ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i Spreading an array into an object creates properties named after its indexes.
  
    1 │ /* should generate diagnostics */
  > 2 │ const fromArray = <div {...[1, 2, 3]} />;
      │                            ^^^^^^^^^
    3 │ 
