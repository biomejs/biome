	static KINDS = nodeKinds("JS_CALL_EXPRESSION");
	static {
		this.OTHER = nodeKinds("JS_NEW_EXPRESSION");
	}
}

export const rule = defineRule({
	run(node, set) {
		otherKinds("JS_CALL_EXPRESSION");
		set.union(CALLS);
		MUTABLE.union(CALLS);
		new Set([1]).union(other);
		return BOTH.has(node);
