# Input
```js
if (array.length === 0 || array.every(Boolean));

if (array.length !== 0 && array.some(Boolean));

if (array.length > 0 && array.some(Boolean));

if (!array.length || array.every(Boolean));

if ((array.length === 0) || (array.every(Boolean)));
```

