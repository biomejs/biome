---
source: crates/biome_js_analyze/tests/spec_tests.rs
expression: invalid.js
---
# Input
```js
/* should generate diagnostics */
import { useInfiniteQuery, useSuspenseInfiniteQuery as useData, infiniteQueryOptions } from "@tanstack/react-query";

useInfiniteQuery({
	queryKey: ["a"],
	getNextPageParam: (p) => p.next,
	queryFn: () => fetchA(),
	initialPageParam: 0,
});

useData({
	getNextPageParam: (p) => p.next,
	getPreviousPageParam: (p) => p.prev,
	queryFn() {},
});

infiniteQueryOptions({
	getPreviousPageParam,
	queryFn,
	getNextPageParam,
});

useInfiniteQuery({
	getNextPageParam,
	queryFn,
});

useInfiniteQuery(({
	// next page
	getNextPageParam,
	// fetcher
	queryFn,
}));

useInfiniteQuery({
	getNextPageParam,
	"queryFn": fetchA,
});

useInfiniteQuery({
	getNextPageParam,
	queryFn: a,
	queryFn: b,
});

```

# Diagnostics
```
invalid.js:6:2 lint/nursery/useTanstackQueryInfiniteQueryPropertyOrder  FIXABLE  ━━━━━━━━━━━━━━━━━━━

  ! The properties of this infinite query are in the wrong order.
  
    4 │ useInfiniteQuery({
    5 │ 	queryKey: ["a"],
  > 6 │ 	getNextPageParam: (p) => p.next,
      │ 	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    7 │ 	queryFn: () => fetchA(),
    8 │ 	initialPageParam: 0,
  
  i TanStack Query infers types from the order of the properties. Write queryFn, then getPreviousPageParam, then getNextPageParam.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  
  i Unsafe fix: Reorder the properties.
  
     4  4 │   useInfiniteQuery({
     5  5 │     queryKey: ["a"],
     6    │ - → getNextPageParam:·(p)·=>·p.next,
     7    │ - → queryFn:·()·=>·fetchA(),
        6 │ + → queryFn:·()·=>·fetchA(),
        7 │ + → getNextPageParam:·(p)·=>·p.next,
     8  8 │     initialPageParam: 0,
     9  9 │   });
  

```

