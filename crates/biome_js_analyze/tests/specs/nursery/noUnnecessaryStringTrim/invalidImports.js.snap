      2 │ + import·{·z·as·a·}·from·"other-package";·a.string().trimStart().startsWith("-");
    3 3 │   import * as b from "other-package"; b.string().trim().startsWith("-");
    4 4 │   import { string as c } from "zod"; c.string().trim().startsWith("-");
  

