invalid.ts:4:2 lint/nursery/useIteratorZip ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i This for loop only uses its index to read the same position from several arrays.
  
    3 │ function annotatedArrays(names: readonly string[], scores: number[]) {
  > 4 │ 	for (let index = 0; index < Math.min(names.length, scores.length); index++) {
      │ 	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    5 │ 		save(names[index], scores[index]);
    6 │ 	}
  
  i Iterator.zip() returns the elements at the same position together and stops at the end of the shortest array, so the loop needs neither an index nor a length check.
  
  i Use a for...of loop over Iterator.zip() instead.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

