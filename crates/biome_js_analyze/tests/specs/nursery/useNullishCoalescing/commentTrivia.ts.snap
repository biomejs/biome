# Input
```ts
/* should generate diagnostics */

declare const a: object | null;
declare const b: object | undefined;

// `||` with comments
const x = a /* inline comment */ || {};
const y = a || /* inline comment */ {};
const z = a /* before */ || /* after */ {};

// Line comments around the operator
const w = b
  // line comment before
  || {};

const v = b ||
  // line comment after
  {};

// `||=` with comments
declare let assigned: object | null;

assigned /* before */ ||= {};
assigned ||= /* after */ {};
assigned /* before */ ||= /* after */ {};

// Ternary with comments
declare const nonNull: string | null;
const t1 = nonNull !== null ? /* non-null value */ nonNull : /* fallback */ 'default';

declare const checked: string | null;
const t2 = /* check */ checked === null ? 'fallback' : checked;

declare const negated: string | null;
const t3 = negated === null ? /* fallback */ 'default' : /* value */ negated;

```

# Diagnostics
```
commentTrivia.ts:7:34 lint/nursery/useNullishCoalescing  FIXABLE  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i Use ?? instead of ||.
  
    6 │ // `||` with comments
  > 7 │ const x = a /* inline comment */ || {};
      │                                  ^^
    8 │ const y = a || /* inline comment */ {};
    9 │ const z = a /* before */ || /* after */ {};
  
  i The || operator checks for all falsy values (including 0, '', and false), while ?? only checks for null and undefined.
  
  i This rule is still being actively worked on, so it may be missing features or have rough edges. Visit https://github.com/biomejs/biome/issues/8043 for more information or to report possible bugs.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  
  i Safe fix: Replace || with ??.
  
     5  5 │   
     6  6 │   // `||` with comments
     7    │ - const·x·=·a·/*·inline·comment·*/·||·{};
        7 │ + const·x·=·a·/*·inline·comment·*/·??·{};
     8  8 │   const y = a || /* inline comment */ {};
     9  9 │   const z = a /* before */ || /* after */ {};
  

