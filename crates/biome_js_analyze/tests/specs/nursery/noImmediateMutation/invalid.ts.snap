# Input
```ts
/* should generate diagnostics */
const array1: number[] = [1];
array1.push(2);

let foo1: number;
foo1 = 1;

let foo2!: number;
foo2 = 1;

let r: number, g: number;
[r, g] = colors;

const set1 = new Set<number> // comment
set1.add(1)

```

