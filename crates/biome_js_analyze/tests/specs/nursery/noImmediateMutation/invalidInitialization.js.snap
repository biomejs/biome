# Input
```js
/* should generate diagnostics */
let foo1;
foo1 = 1;

var foo2;
foo2 = bar();

let foo3, other1;
foo3 = 1;

let r, g, b, other2;
[r, g, b] = colors;

var x, y;
[x, , y] = values;

let callback;
callback = () => callback();

var counter;
counter = counter + 1;

let foo4
foo4 = 1

let foo5; // comment
foo5 = 1;

```

