# Input
```js
/* should generate diagnostics */
import { derived, readable, writable } from "svelte/store";
import { writable as createStore } from "svelte/store";
import * as stores from "svelte/store";

const a = writable(false, async () => {});
const b = readable(false, async () => {});
const c = derived(a, async ($a) => {});
const d = writable(false, async function () {});
const e = readable(false, async function* () {});
const f = writable(false, (async () => {}));
const g = createStore(false, async () => {});
const h = stores.writable(false, async () => {});
const i = stores["derived"](a, async ($a, set) => {});

```

# Diagnostics
```
invalid.js:6:27 lint/nursery/noSvelteAsyncStore ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i This async function is passed to writable().
  
    4 │ import * as stores from "svelte/store";
    5 │ 
  > 6 │ const a = writable(false, async () => {});
      │                           ^^^^^
    7 │ const b = readable(false, async () => {});
    8 │ const c = derived(a, async ($a) => {});
  
  i Svelte calls the value this function returns when the store is no longer used. An async function returns a promise, and calling a promise throws an error.
  
  i Make the function synchronous, start the async work inside it, and call set() when the result is ready.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  

```

