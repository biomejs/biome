invalid.js:2:11 lint/nursery/noObjectConstructor  FIXABLE  ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  i Calling Object without arguments creates an empty object.
  
    1 │ /* should generate diagnostics */
  > 2 │ const a = Object();
      │           ^^^^^^^^
    3 │ const b = new Object();
    4 │ const c = new Object;
  
  i Writing {} is shorter, and it always creates a plain object, even if other code replaces the global Object.
  
  i This rule belongs to the nursery group, which means it is not yet stable and may change in the future. Visit https://biomejs.dev/linter/#nursery for more information.
  
  i Unsafe fix: Use an object literal.
  
     1  1 │   /* should generate diagnostics */
     2    │ - const·a·=·Object();
        2 │ + const·a·=·{};
     3  3 │   const b = new Object();
     4  4 │   const c = new Object;
  

