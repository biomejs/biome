<div>{items.map((item) => <span set:text={item.text}>{
    // only a comment
}</span>)}</div>

<div>{show && <Component set:html="html" set:text="text" />}</div>
<div>{show && <Component set:html={html} set:text={text}>text child</Component>}</div>
