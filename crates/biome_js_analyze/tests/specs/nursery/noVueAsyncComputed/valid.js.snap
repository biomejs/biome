	});
	const conditionalArrow = computed(() => {
		return this.bar ? () => Promise.resolve(1) : null;
	});
	const conditionalAsyncArrow = computed(() => {
		return this.bar ? async () => 1 : null;
	});
	const plainCall = computed(() => {
		bar();
	});
	return { empty };
}

function shadowedGlobals() {
	const Promise = { all: () => 1, resolve: () => 1 };
	const setTimeout = (callback) => callback();
	return computed(() => {
		setTimeout(() => {});
		new Promise(() => {});
		return Promise.all([]) + Promise.resolve();
	});
}

function shadowedWindow() {
	const window = { setTimeout: (callback) => callback(), Promise: class {} };
	return computed(() => {
		window.setTimeout(() => {}, 0);
		return new window.Promise();
	});
}

function shadowedNextTick() {
	const nextTick = (callback) => callback();
	return computed(() => nextTick(() => 1));
}

