/* should not generate diagnostics */
function deleteValues(set: Set<string>) {
	for (const value of set.values()) {
		set.delete(value);
	}
}

function deleteEntries(map: Map<string, number>) {
	for (const entry of map) {
		map.delete(entry);
	}
}

function reinsert(set: Set<number>) {
	for (const value of (set as Set<number>)) {
		try {
			set.delete(value);
		} finally {
			continue;
		}
		set.add(value);
	}
}

