# Input

```css
@function --inset ( --padding : 8px   16px ,--single:center,--required){result:var(--padding)}
.card{padding:--inset()}

@function --typed( --padding /* type */ <length>+ /* colon */ :8px  16px,--color type(<color>|<custom-ident>):red )returns <length>+{result:var(--padding)}
@function --nested(--value:0  1px rgb(0,  0,0),--fallback:var(--size,8px  16px) calc(100% - var(--offset,  2px))){result:var(--value)}
@function --blocks(--value:first {a, /* middle */ b} last,--nested:fn({a; b !important},[c, d]) tail,--empty:{/* empty */}){result:var(--value)}

@function --comments(--value:/* first */8px /* between */
16px /* last */,
/* parameter */--other:4px  12px/* end */)/* returns */returns <length>+{result:var(--value)}
@function --default-suppression(--value: /* biome-ignore format: preserve the value component */ 8px    16px,--other:4px 12px){result:var(--value)}
@function --parameter-suppression(
/* biome-ignore format: preserve this parameter */
--padding:   8px    16px,--other:1px  2px){result:var(--padding)}
/* biome-ignore format: preserve the complete function */
@function --suppressed( --value:8px    16px , --other:4px ){result:var(--value)}

```


# Formatted

```css
@function --inset(--padding: 8px 16px, --single: center, --required) {
	result: var(--padding);
}
.card {
	padding: --inset();
}

@function --typed(
	--padding /* type */ <length>+ /* colon */: 8px 16px,
	--color type(<color> | <custom-ident>): red
) returns <length>+ {
	result: var(--padding);
}
@function --nested(
	--value: 0 1px rgb(0, 0, 0),
	--fallback: var(--size, 8px 16px) calc(100% - var(--offset, 2px))
) {
	result: var(--value);
}
@function --blocks(
	--value: first {a, /* middle */ b} last,
	--nested: fn({a; b !important}, [c, d]) tail,
	--empty: {/* empty */}
) {
	result: var(--value);
}

@function --comments(
	--value: /* first */ 8px /* between */
	16px /* last */,
	/* parameter */ --other: 4px 12px /* end */
) /* returns */ returns <length>+ {
	result: var(--value);
}
@function --default-suppression(
	--value: /* biome-ignore format: preserve the value component */ 8px 16px,
	--other: 4px 12px
) {
	result: var(--value);
}
@function --parameter-suppression(
	/* biome-ignore format: preserve this parameter */
	--padding:   8px    16px,
	--other: 1px 2px
) {
	result: var(--padding);
}
/* biome-ignore format: preserve the complete function */
@function --suppressed( --value:8px    16px , --other:4px ){result:var(--value)}

```
