# Input

```css
.a{
 font-family:if;
 selected:if(style(--enabled: true):if;else : serif);
 fallback:if(style(--enabled: true): serif;else :if);
 sequence:if(style(--enabled: true):if  serif;else : serif);
 nested:if(style(--enabled: true):if(media(width > 10px):if;else : serif);else :if);
}
.comments{font-family:if(style(--enabled: true): /* before */ if /* after */;else:/* fallback */if)}

.queries{
 grouped:if((style(--enabled: true)):red;else:blue);
 nested:if(not (style(--value: fn("),:;", nested(red, blue)))):red;else:blue);
}

```


# Formatted

```css
.a {
	font-family: if;
	selected: if(style(--enabled: true): if; else: serif);
	fallback: if(style(--enabled: true): serif; else: if);
	sequence: if(style(--enabled: true): if serif; else: serif);
	nested: if(
		style(--enabled: true): if(media(width > 10px): if; else: serif);
		else: if;
	);
}
.comments {
	font-family: if(
		style(--enabled: true): /* before */ if /* after */;
		else: /* fallback */ if;
	);
}

.queries {
	grouped: if((style(--enabled: true)): red; else: blue);
	nested: if(
		not (
			style(--value: fn("),:;", nested(red, blue)))
		): red;
		else: blue;
	);
}

```
