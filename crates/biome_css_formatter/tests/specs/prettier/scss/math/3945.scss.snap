@function gcd($a,$b){
  // From: http://rosettacode.org/wiki/Greatest_common_divisor#JavaScript
  @if ($b != 0) {
    @return gcd($b,$a % $b);
  }@else{
    @return abs($a);
  }
}

$colors: (
primary: (
base: #00abc9,
light: #daf1f6,
dark: #12799a
),
secondary: (
base: #424d55,
light: #ccc,
lightest: #efefef,
dark: #404247
),
success: (
base: #bbd33e,
light: #eaf0c6
)
);

@function color($color, $tone: "base") {
@return map-get(map-get($colors, $color), $tone);
}

