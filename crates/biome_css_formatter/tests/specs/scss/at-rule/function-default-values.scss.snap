# Input

```scss
$gap:8px;

@function --inset ( --padding  :  8px   16px ){result:var(--padding)}
.card{padding:--inset()}
.override{padding:--inset(4px 12px)}

@function --typed-inset( --padding /* type */ <length>+ /* colon */ : 8px   16px )returns <length>+{result:var(--padding)}

@function --shadow(--value:0  1px 2px rgb(0, 0,0),--extra:var(--gap,1px  2px) calc(100% - var(--offset, 2px))){result:var(--value)}

@function --literal(--value:$gap   16px,--operator:1 + 2){result:var(--value)}

@function --interpolated(--value:#{ $gap }   16px,--nested:var(--gap,#{ $gap } 16px)){result:var(--value)}

@function --comments(
--value:/* first */ #{ $gap } /* between */
16px /* last */,
/* parameter */--other:left  top/* end */
)/* returns */returns <length>+{result:var(--value)}

@function --controls(--required,--single:8px){result:var(--single)}

@function ordinary($value:1 + 2,$padding:8px 16px){@return $value;}

@function --default-suppression(--value: /* biome-ignore format: preserve the value component */ #{ $gap }    16px,--other:4px 12px){result:var(--value)}

/* biome-ignore format: preserve the complete function */
@function --suppressed( --value:#{ $gap }    16px , --other:4px ){result:var(--value)}

.after-functions{padding:ordinary()}

@function --parameter-suppression(
/* biome-ignore format: preserve this parameter */
--padding:   8px    16px,
--other: 1px  2px
){result:var(--padding)}

```


# Formatted

```scss
$gap: 8px;

@function --inset(--padding: 8px 16px) {
	result: var(--padding);
}
.card {
	padding: --inset();
}
.override {
	padding: --inset(4px 12px);
}

@function --typed-inset(
	--padding /* type */ <length>+ /* colon */: 8px 16px
) returns <length>+ {
	result: var(--padding);
}

@function --shadow(
	--value: 0 1px 2px rgb(0, 0, 0),
	--extra: var(--gap, 1px 2px) calc(100% - var(--offset, 2px))
) {
	result: var(--value);
}

@function --literal(--value: $gap 16px, --operator: 1 + 2) {
	result: var(--value);
}

@function --interpolated(
	--value: #{$gap} 16px,
	--nested: var(--gap, #{$gap} 16px)
) {
	result: var(--value);
}

@function --comments(
	--value: /* first */ #{$gap} /* between */
	16px /* last */,
	/* parameter */ --other: left top /* end */
) /* returns */ returns <length>+ {
	result: var(--value);
}

@function --controls(--required, --single: 8px) {
	result: var(--single);
}

@function ordinary($value: 1 + 2, $padding: 8px 16px) {
	@return $value;
}

@function --default-suppression(
	--value: /* biome-ignore format: preserve the value component */ #{ $gap } 16px,
	--other: 4px 12px
) {
	result: var(--value);
}

/* biome-ignore format: preserve the complete function */
@function --suppressed( --value:#{ $gap }    16px , --other:4px ){result:var(--value)}

.after-functions {
	padding: ordinary();
}

@function --parameter-suppression(
	/* biome-ignore format: preserve this parameter */
	--padding:   8px    16px,
	--other: 1px 2px
) {
	result: var(--padding);
}

```

