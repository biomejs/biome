@supports selector(:focus-visible) and
	font-tech(color-COLRv1) and
	font-format(woff2) and
	(display: grid) {
	.controls {
		display: grid;
	}
}
.conditional-value {
	color: if(supports(at-rule(@property)): green; else: red);
}

$prefix: overflow-;
$axis: x;
$condition: "(display: grid)";
@supports ($prefix + $axis: clip) and at-rule(@property) {
	.computed {
		overflow-x: clip;
	}
}
@supports #{$condition} and at-rule(@function) {
	.interpolated {
		display: grid;
	}
}
@supports (at-rule(foo): bar) {
	.computed-function-name {
		color: green;
	}
}
@supports (at-rule(): bar) {
	.computed-empty-name {
		color: green;
	}
}

/* biome-ignore format: preserve query layout */
@supports  at-rule(  @property  ){.suppressed{color:green}}
@supports at-rule(/* biome-ignore format: preserve at-keyword */ @PROPERTY) {
	.name-comment {
		color: green;
	}
}
@supports not at-rule( @ /* split */ property; extra ) {
	.fallback-comment {
		color: green;
	}
}

