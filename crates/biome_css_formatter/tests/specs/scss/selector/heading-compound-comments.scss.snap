	color: red;
}
:heading(1) /**/ .foo {
	color: red;
}
:heading(1) /**/ .foo {
	color: red;
}
:heading(1) /**/ > .foo {
	color: red;
}
:HEADING( 1 )/* biome-ignore format: x */:heading(2, 3) {
	color: red;
}
.foo/* biome-ignore format: x */:heading(1, 2) {
	color: red;
}

/* biome-ignore format: preserve the rule */
:heading( 1 )/**/.foo { color:red; }

:/**/heading(1) {
	color: red;
}
:/* first *//* second */heading(1, 2) {
	color: red;
}
