# Input

```scss
$formats: null;
$isVariable: false;
.fontsource-default{ formats:if(not $formats or $formats == all ,if($isVariable ,woff2 ,(woff2 ,woff)) ,$formats); }
$formats: all;
$isVariable: true;
.fontsource-all{ formats:if(not $formats or $formats == all ,if($isVariable ,woff2 ,(woff2 ,woff)) ,$formats); }
$formats: woff;
.fontsource-custom{ formats:if(not $formats or $formats == all ,if($isVariable ,woff2 ,(woff2 ,woff)) ,$formats); }

$media-width: 12rem;
.richie-horizontal{ direction:if(($media-width and $media-width > 0) ,'horizontal' ,'vertical'); }
$media-width: null;
.richie-vertical{ direction:if(($media-width and $media-width > 0) ,'horizontal' ,'vertical'); }
$media-width: 0;
.richie-zero{ direction:if(($media-width and $media-width > 0) ,'horizontal' ,'vertical'); }

```


# Formatted

```scss
$formats: null;
$isVariable: false;
.fontsource-default {
	formats: if(
		not $formats or $formats == all,
		if($isVariable, woff2, (woff2, woff)),
		$formats
	);
}
$formats: all;
$isVariable: true;
.fontsource-all {
	formats: if(
		not $formats or $formats == all,
		if($isVariable, woff2, (woff2, woff)),
		$formats
	);
}
$formats: woff;
.fontsource-custom {
	formats: if(
		not $formats or $formats == all,
		if($isVariable, woff2, (woff2, woff)),
		$formats
	);
}

$media-width: 12rem;
.richie-horizontal {
	direction: if(($media-width and $media-width > 0), "horizontal", "vertical");
}
$media-width: null;
.richie-vertical {
	direction: if(($media-width and $media-width > 0), "horizontal", "vertical");
}
$media-width: 0;
.richie-zero {
	direction: if(($media-width and $media-width > 0), "horizontal", "vertical");
}

```
