$map:if(sass(false):(first:1px + 2px);else:(else:(4px,5px)));
.true{width:if(sass(true):1px+2px;else:4px+5px);padding:if(sass(true):1px+2px 4px*2;else:5px 7px);font-family:if(sass(true):serif,monospace;else:system-ui,sans-serif);color:red if(sass(true):!important;else:null)}
.false{width:if(sass(false):(1px+2px)*3;else:(4px+5px)*2);padding:if(sass(false):1px 2px;else:3px 4px);font-family:if(sass(false):serif,monospace;else:system-ui,sans-serif);color:red if(sass(false):!important;else:null)}
