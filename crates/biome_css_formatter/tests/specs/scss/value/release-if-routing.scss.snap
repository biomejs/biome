# Input

```scss
@use "sass:math";
$feature: "hover";

.a{
 not-condition:if(not style(--enabled: true):red ; else :blue);
 grouped-condition:if((style(--enabled: true)):red ; else :blue);
 nested-condition:if(not (style(--value: fn("),:;", nested(red, blue)))):red ; else :blue);
 sass-true:if(sass(true):red ; else :blue);
 sass-not:if(sass(not false):red ; else :blue);
 nested-if:if(sass(if(sass(true): true; else: false)):red ; else :blue);
 media:if(media(width > 10px):red ; else :blue);
 supports:if(supports(display: grid):red ; else :blue);
 raw-url:if(sass(url(https://example.com/a{b:c,d)):red ; else :blue);
 legacy-condition:if(sass(if(not false,true,false)):red ; else :blue);
 comma-value:if(style(--enabled: true):Arial,sans-serif;else : serif);
 interpolated-feature:if(media((#{$feature})): red; else: blue);
 namespaced-bound:if(media(math.$pi < width): red; else: blue);
 parent-suffix:if(supports(selector(&+100)): red; else: blue);
}
.comments {color:if(not style(--enabled: true) /* before : */ : /* after : */ red; /* after ; */ else:blue);width:if(sass((true) /* inner */):red;else:blue)}
/* biome-ignore format: preserve the authored conditional layout */
.suppressed { color : if( sass(true):red;else:blue ) }

```


# Formatted

```scss
@use "sass:math";
$feature: "hover";

.a {
	not-condition: if(not style(--enabled: true): red; else: blue);
	grouped-condition: if((style(--enabled: true)): red; else: blue);
	nested-condition: if(
		not (
			style(--value: fn("),:;", nested(red, blue)))
		): red;
		else: blue;
	);
	sass-true: if(sass(true): red; else: blue);
	sass-not: if(sass(not false): red; else: blue);
	nested-if: if(sass(if(sass(true): true; else: false)): red; else: blue);
	media: if(media(width > 10px): red; else: blue);
	supports: if(supports(display: grid): red; else: blue);
	raw-url: if(sass(url(https://example.com/a{b:c,d)): red; else: blue);
	legacy-condition: if(sass(if(not false, true, false)): red; else: blue);
	comma-value: if(style(--enabled: true): Arial, sans-serif; else: serif);
	interpolated-feature: if(media((#{$feature})): red; else: blue);
	namespaced-bound: if(media(math.$pi < width): red; else: blue);
	parent-suffix: if(supports(selector(&+100)): red; else: blue);
}
.comments {
	color: if(
		not style(--enabled: true) /* before : */: /* after : */ red;
		/* after ; */ else: blue;
	);
	width: if(sass((true) /* inner */): red; else: blue);
}
/* biome-ignore format: preserve the authored conditional layout */
.suppressed { color : if( sass(true):red;else:blue ) }

```
