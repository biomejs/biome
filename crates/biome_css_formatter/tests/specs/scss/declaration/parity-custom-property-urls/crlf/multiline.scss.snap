	--interpolated: url(#{"asset\<CRLF>
-name.svg"});<CRLF>
	--multiline: url(/icons/#{<CRLF>
"mark"<CRLF>
}.svg);<CRLF>
	color: red;<CRLF>
}<CRLF>

