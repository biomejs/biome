source: crates/biome_css_parser/tests/spec_test.rs
expression: snapshot
---

## Input

```css
$gap: 8px;

@function --semicolon(--value: #{$gap}; 16px, --after: 4px) {
  result: var(--after);
}
.after-semicolon { color: red; }

@function --important(--value: $gap 16px !important, --after: 4px) {
  result: var(--after);
}
.after-important { color: red; }

@function --mismatched(--value: var(--gap, #{$gap}], --after: 4px) {
  result: var(--after);
}
.after-mismatched { color: red; }

@function --unmatched(--value: [#{$gap} 16px), --after: 4px) {
  result: var(--after);
}
.after-unmatched { color: red; }

@function --missing-outer(--value: #{$gap} 16px {
  result: var(--value);
}
.after-missing-outer { color: red; }

```


