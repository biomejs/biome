---
source: crates/biome_css_parser/tests/spec_test.rs
expression: snapshot
---

## Input

```css
$name:data-width;$gap:2px;
@container card attr($name){.a{color:red}}
@container card attr(data-size px,$gap*2){.b{height:1px}}
@container card unknown(attr(data-size px,$gap*2)){.c{color:green}}
.after{display:block}
$unit:px;$suffix:em;
@container card attr(data-width $unit,10px){.variable-unit{color:red}}
@container card unknown(attr(data-width $unit,10px)){.nested-variable-unit{color:green}}
@container card attr(data-width #{$unit},10px){.interpolated-unit{color:blue}}
@container card attr(data-width r#{$suffix},1rem){.prefixed-unit{color:purple}}
@container card type(<length>){.type-outside-attr{color:orange}}
.after-units{display:block}

```


