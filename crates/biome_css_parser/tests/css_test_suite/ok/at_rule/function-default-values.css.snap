## Input

```css
@function --inset(--padding: 8px 16px) {
  result: var(--padding);
}

.card {
  padding: --inset();
}

.override {
  padding: --inset(4px 12px);
}

@function --typed-inset(--padding <length>+: 8px 16px) returns <length>+ {
  result: var(--padding);
}

@function --shadow(
  --value: 0 1px 2px rgb(0, 0, 0),
  --extra: 1px
) {
  result: var(--value);
}

@function --fallback(
  --value: var(--size, 8px 16px) calc(100% - var(--offset, 2px)),
  --color type(<color> | <custom-ident>): red
) returns <length>+ {
  result: var(--value);
}

@function --position(--value: left top, --single: center, --required) {
  result: var(--value);
}

@function --tokens(--type-tokens: 10px <length>, --colon-tokens: 1: 2) {
  result: var(--type-tokens);
}

@function --nested-boundaries(
  --value: unknown(a; b !important, c) 8px,
  --brackets: [a, b] 8px,
  --other: 2px
) {
  result: var(--value);
}

@function --comments(
  --value: /* first */ 8px /* between */
    16px /* last */,
  /* parameter */ --other: 4px 12px /* end */
) /* returns */ returns <length>+ {
  result: var(--value);
}

.after-functions {
  padding: 1px;
}

@function --url-boundaries(
  --open-curly: url(a{b), --close-curly: url(a}b),
  --open-bracket: url(a[b), --close-bracket: url(a]b),
  --nested: var(--image, url(a{b)), --quoted: url("a[b"),
  --function: url(var(--image)), --literal: url($literal,b)
) { result: var(--open-curly); }

```


