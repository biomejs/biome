## Input

```css
@keyframes fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }

  @at-root (without: all) {
    .fade-in {
      animation: fade-in 200ms ease;
    }

    @media (prefers-reduced-motion: reduce) {
      .fade-in {
        animation: none;
      }
    }
  }
}

@keyframes a {
  @at-root (without: all) {
    b { c: d }
  }
}

$query: "without: all";
@keyframes between-steps {
  from { opacity: 0; }
  // Before the escaped rule.
  @at-root (/* query */ $query /* before close */) /* before body */ {
    /* inside body */
    .between-steps { animation: between-steps 200ms; }
    /* end body */
  } // After the escaped rule.
  to { opacity: 1; }
}

@keyframes shorthand {
  @at-root /* before selector */ from, to /* before body */ { opacity: 0; }
  50% { opacity: 0.5; }
}

.after { color: red; }

@keyframes percentages {
  @at-root 25%, 75% { opacity: 0.25; }
  @at-root from, 50%, to { opacity: 0.5; }
  @at-root #{25 + 25}% { opacity: 1; }
  @at-root (with: keyframes) {
    @at-root 60% { opacity: 0.6; }
  }
}

@mixin step($position) {
  @at-root #{$position}% { opacity: 0.5; }
}

@keyframes reusable {
  @include step(50);
}

@at-root from .ordinary { color: red; }
@at-root from, .ordinary { color: blue; }
$selector: ".interpolated";
@at-root #{$selector} { color: green; }

@at-root #{"div"}%from { color: red; }
@at-root from, #{"span"}%to { color: blue; }
.extended {
  @extend %from;
  @extend %to;
}

```


