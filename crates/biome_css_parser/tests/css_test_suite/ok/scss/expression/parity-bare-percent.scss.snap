## Input

```css
$unit: %;
$default-unit: % !default;
$default-list: 10 % !default;
$global-unit: null;
$global-unit: % !global;
$global-list: null;
$global-list: 10 % !global;

@mixin width-in($amount, $unit: %) {
  width: #{$amount}#{$unit};
}
@function percent($unit: %) {
  @return %;
}
.progress { @include width-in(75); }
.sidebar { @include width-in(320, px); }
.progress-explicit { @include width-in(50, %); }

$grouped: (%);
$bracketed: [%, px];
$map: (unit: %);
$leading: % foo;
$trailing: foo %;
$number-list: 10 %;
$comparison-list: 10 % == 3;
$modulo: 10 % 3;
$modulo-adjacent: 10 %3;
$percentage-adjacent: 10%3;
$percentage-spaced: 10% 3;
$addition: % + 1;
$percent-list: % %;
$comma-list: %, px;
$grouped-list: (%, px);
$negative-list: % -1;
$negative-modulo: 10 % -3;
$three: 3;
$variable-modulo: 10 % $three;
$modulo-comments: 10 /* left */ % /* right */ 3;
$trailing-comments: 10 /* number */ % /* unit */;
$leading-comments: % /* unit */ foo;
$number-newline: 10
  %;
$trailing-newline: foo
  %;
$modulo-newlines: 10
  %
  3;

%placeholder { width: 75%; }
.controls {
  @extend %placeholder;
  width: 75%;
  width: attr(data-progress %, 0%);
  width: attr(data-progress %, %);
  unit: % !important;
  generic: unknown(%, 10 %, % foo, foo %);
  returned: percent(%);
  interpolation: #{%};
  arithmetic: (2 + 3) * 4;
  --unit: %;
  --raw: 10 % +;
}

```


