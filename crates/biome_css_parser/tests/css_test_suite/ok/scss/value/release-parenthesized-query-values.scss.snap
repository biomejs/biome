---
source: crates/biome_css_parser/tests/spec_test.rs
expression: snapshot
---

## Input

```css
@use "sass:math";

$device: 768px;

@media screen and (max-width: ($device - 1px)) {
  .card { display: block; }
}

@media (min-width: (($device + 1px))) {
  .card { display: block; }
}

@media (width >= ($device - 1px)) and (400px < width < 900px) {
  .range { display: block; }
}

@media (aspect-ratio: 16/9) and (min-width: calc(100vw - 1px)) {
  .native { display: block; }
}

@container style(--tokens: 16/9 + 1px and (foo)) {
  .raw { display: block; }
}

@media (400px < width < ($device + 1px)) {
  .upper { display: block; }
}

@media (max-width: ($device - 1px) + 2px) {
  .continued { display: block; }
}

@function below($value) {
  @return $value - 1px;
}

@media (max-width: (below(below($device)))) {
  .nested-call { display: block; }
}

@media (min-width: (math.div($device, 2))) {
  .qualified-call { display: block; }
}

@media (width: (attr(data-width type(<length>), 1px))) {}

@media (width: (url("x{y}"))) {}

@media (width: (if(sass(true): 1px; else: 2px))) {}

```


