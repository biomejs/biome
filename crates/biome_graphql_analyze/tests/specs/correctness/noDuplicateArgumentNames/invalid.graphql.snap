# Input
```graphql
# should generate diagnostics
query A {
	field(arg1: "value", arg1: "value")
}
query B {
	field(arg1: "value", arg1: "value", arg1: "value")
}
query C {
	field @directive(arg1: "value", arg1: "value")
}
query D {
	field @directive(arg1: "value", arg1: "value", arg1: "value")
}
query E {
	field(a: 1, b: 2, a: 3, b: 4)
}

```

