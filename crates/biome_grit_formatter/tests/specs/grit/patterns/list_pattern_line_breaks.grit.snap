# Input

```grit
language js

`foo($x)` as $c where {
  register_diagnostic(span=$c, message=join(list=["aaaaaaaaaaaaaaaaaaaa", $x, "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"], separator=""))
}

`bar($x)` where {
  $x <: [
    `1`,
    `2`,

    `3`
  ]
}

```


# Formatted

```grit
language js

`foo($x)` as $c where {
	register_diagnostic(span=$c, message=join(list=[
		"aaaaaaaaaaaaaaaaaaaa", $x,
		"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
	], separator=""))
}

`bar($x)` where {
	$x <: [
		`1`, `2`,

		`3`
	]
}

```
