[hello](#world 'title')
[hello](#world (title))

[a](https://example.com "\"")
[a](https://example.com '\"')
[a](https://example.com (\"))

[a](https://example.com "\'")
[a](https://example.com '\'')
[a](https://example.com (\'))

[a](https://example.com "\'")
[a](https://example.com '\)')
[a](https://example.com (\)))

[a](https://example.com "\\\"")
[a](https://example.com '\\\'')
[a](https://example.com (\\\)))

[a](https://example.com "\\'")
[a](https://example.com '\\"')
[a](https://example.com (\\"))

<!-- magical incantations -->

[a](https://example.com "\"')")
[a](https://example.com '"\')')
[a](https://example.com ("'\)))

```


