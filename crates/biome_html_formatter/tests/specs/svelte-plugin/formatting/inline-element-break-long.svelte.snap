         ><span>hi</span><span>hi</span></span
     ></span
-> <span>hi</span>
+>
+<span>hi</span>
 <div>
     <span
-        ><span>looooooooooong</span
+        ><span
+            >looooooooooong</span
         >looooooooooonglooooooooooonglooooooooooonglooooooooooonglooooooooooong<span
             ><span>hi</span><span>hi</span></span
         ></span
     ><span>hi</span>
     <span
-        ><span>looooooooooong</span
+        ><span
+            >looooooooooong</span
         >looooooooooonglooooooooooonglooooooooooonglooooooooooonglooooooooooong<span
             ><span>hi</span><span>hi</span></span
         ></span
     >
 </div>
 <span
-    ><span>looooooooooong</span
+    ><span
+        >looooooooooong</span
     >looooooooooonglooooooooooonglooooooooooonglooooooooooonglooooooooooong<span
         ><span>hi</span><span>hi</span></span
     ></span
