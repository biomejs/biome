<a use:link="{linkValues + 'asd'}">Link</a>
<a href="{linkValues + 'asd'}">Link</a>
<button on:click="{() => console.log('hi')}">hi</button>
<div in:asd="{foo + 'bar'}" out:asd="{foo + 'bar'}"></div>
