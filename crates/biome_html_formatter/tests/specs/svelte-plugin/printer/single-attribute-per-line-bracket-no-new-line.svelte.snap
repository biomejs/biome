     id="x"
-    class="y">Copy</span>
+    class="y"
+    >Copy</span
+>
 
 <div
     id="x"
     class:y={true}
     style:marginLeft="4px"
-    on:click={onClick}>
-</div>
+    on:click={onClick}></div>
 
 <svelte:body
     on:mouseenter={handleMouseenter}
@@ -52,7 +53,9 @@
 
 <svelte:fragment
     slot="named"
-    let:foo><p>hi</p></svelte:fragment>
+    let:foo
+    ><p>hi</p></svelte:fragment
+>
 
 <svelte:window
     on:event={handler}
```

