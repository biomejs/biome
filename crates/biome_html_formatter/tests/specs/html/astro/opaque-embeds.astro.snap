# Input

```astro
---
const title = "Opaque";
---
<div><span>before</span></div>

<style lang="less">
  .mixin(@color) { color: @color; }
</style>

<style type="text/less">
@width: 10px;
.card { width: @width; }
</style>

<script lang="coffee">
  square = (value) -> value * value
</script>

<script type="text/x-template">
  <section>{{ title }}</section>
</script>

<div><span>after</span></div>

```


