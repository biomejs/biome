# Input

```vue
<template>
  <div>
    <!-- adjacent first -->
    <!-- adjacent second -->
  </div>
  <div>
    <!-- first group -->

    <!-- second group -->
  </div>
  <div>
    <!-- first group -->



    <!-- second group -->
  </div>
  <div>
    <!-- before content -->

    <!-- content group -->
    text content
  </div>
</template>

<template><div><!-- adjacent first --><!-- adjacent second --></div><div><!-- first group -->

<!-- second group --></div><div><!-- first group -->



<!-- second group --></div><div>
<!-- before content -->

<!-- content group -->text content</div></template>

```


