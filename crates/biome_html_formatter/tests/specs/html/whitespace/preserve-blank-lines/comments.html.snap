# Input

```html
<div>
  <!-- adjacent first -->
  <!-- adjacent second -->
</div>
<div>
  <!-- first group -->

  <!-- second group -->
</div>
<div>
  <!-- first group -->



  <!-- second group -->
</div>
<div>
  <!-- before content -->

  <!-- content group -->
  text content
</div>

<div><!-- adjacent first --><!-- adjacent second --></div>
<div><!-- first group -->

<!-- second group --></div>
<div><!-- first group -->



<!-- second group --></div>
<div>
<!-- before content -->

<!-- content group -->text content</div>

```


