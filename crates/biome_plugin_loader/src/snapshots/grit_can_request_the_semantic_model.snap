# Plugin

## `/plugin.js`

```js
import { defineRule, grit, registerDiagnostic } from "@biomejs/runtime/plugin";
export const rule = defineRule({
	query: grit("JsReferenceIdentifier()", { semantic: true }),
	run(node, { model }) {
		const binding = model.binding(node);
		registerDiagnostic(
			node,
			"information",
			`${binding.syntax().text}:${binding.allReads().length}`,
		);
	},
});
```

# Input

## `/file.js`

```js
let value = 1; value;
```

