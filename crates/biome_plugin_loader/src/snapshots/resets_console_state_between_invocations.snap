# Plugin

## `/plugin.js`

```js
import { ast, defineRule } from "@biomejs/runtime/plugin";
console.count("calls");
export const countCalls = defineRule({
	query: ast("JS_CALL_EXPRESSION"),
	run(node) {
		console.count("calls");
		console.time("timer");
		console.log(node.text);
		console.group("left open");
	},
});
```

# Input

## `/file.js`

```js
a(); b();
```

