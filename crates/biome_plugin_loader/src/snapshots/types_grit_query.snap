# Plugin

## `/plugin.js`

```js
import { defineRule, grit, registerDiagnostic } from "@biomejs/runtime/plugin";
export const rule = defineRule({
	query: grit("`load()`", { types: true }),
	run(node, { types }) {
		const ty = types.typeOf(node);
		registerDiagnostic(
			node,
			"information",
			[ty?.toString(), ty?.kind(), types.classifiesAs(node, "promise")].join(
				" | ",
			),
		);
	},
});
```

# Input

## `/file.ts`

```ts
async function load(): Promise<string> { return "done"; }
load();
```

