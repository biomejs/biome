# Plugin

## `/plugin.js`

```js
import { ast, defineRule, registerDiagnostic } from "@biomejs/plugin-api";
export const useMyPlugin = defineRule({
	query: ast("JS_MODULE"),
	run(root) {
		registerDiagnostic(root, "information", "Hello, world!");
	},
});
```

# Input

## `/foo.js`

```js
let foo;
```

## `/bar.js`

```js
let bar;
```

