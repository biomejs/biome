# Plugin

## `/plugin.js`

```js
import {
	ast,
	defineRule,
	nodeKinds,
	registerDiagnostic,
} from "@biomejs/runtime/plugin";
const CALLS = nodeKinds("JS_CALL_EXPRESSION");
const FUNCTIONS_AND_CALLS = nodeKinds(
	"JS_FUNCTION_DECLARATION",
	"JS_ARROW_FUNCTION_EXPRESSION",
	"JS_CALL_EXPRESSION",
);
export const calls = defineRule({
	query: ast("JS_MODULE"),
	run(root) {
		for (const call of root.descendants(CALLS)) {
			registerDiagnostic(
				call,
				"information",
				`descendants() found ${call.callee.text}().`,
			);
		}
	},
});
export const enclosingFunctions = defineRule({
	query: ast("JS_MODULE"),
	run(root) {
		const functions = [];
		root.walk(
			FUNCTIONS_AND_CALLS,
			(node) => {
				if (node.kind === "JS_CALL_EXPRESSION") {
					const enclosing = functions.at(-1) ?? "the module";
					registerDiagnostic(
						node,
						"information",
						`walk() found ${node.callee.text}() in ${enclosing}.`,
					);
				} else if (node.id?.text === "skipped") {
					return false;
				} else {
					functions.push(node.id?.text ?? "an arrow function");
				}
			},
			(node) => {
				if (node.kind !== "JS_CALL_EXPRESSION") {
					functions.pop();
				}
			},
		);
	},
});
```

# Input

## `/file.js`

```js
setup();
function outer() {
    first();
    const inner = () => second(third());
    fourth();
}
function skipped() {
    hidden();
}
last();
```

